<Window x:Class="Echoplex.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Echoplex"
        xmlns:vm="clr-namespace:Echoplex.ViewModels"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="720" MaxHeight="880" FontSize="14" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}" KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- cabecera de sección: icono en el color de acento (Tag: un glifo o un elemento) y el título grande y a todo contraste -->
        <Style x:Key="SectionHeader" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                                <ContentPresenter Content="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="16"
                                                  TextElement.Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" TextElement.FontSize="18"
                                              TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextBrush}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- línea que separa una sección de la anterior -->
        <Style x:Key="SectionRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Margin" Value="0,30,0,26" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- desplegable con flecha (Más temas, Ver cambios de la versión); Tag: texto secundario al lado, como el número de temas -->
        <Style x:Key="DisclosureToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="8,5,10,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
                                <TextBlock Foreground="{DynamicResource Text3Brush}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- tarjeta de tema: una miniatura de la app con sus colores -->
        <DataTemplate x:Key="ThemeCard" DataType="{x:Type local:ThemeOption}">
            <Button Click="Theme_Click" Cursor="Hand" Margin="0,0,10,10" ToolTip="{Binding Info.Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Width="110">
                            <Border x:Name="Frame" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource CardBorderBrush}" Padding="2">
                                <Border CornerRadius="6" Height="74" Background="{Binding Info.Bg}" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding Info.Sidebar}" CornerRadius="6,0,0,6" />
                                        <StackPanel Grid.Column="1" Margin="8,9,8,0">
                                            <Border Height="5" Width="34" HorizontalAlignment="Left" CornerRadius="2" Background="{Binding Info.Text}" />
                                            <Border Height="4" Width="46" HorizontalAlignment="Left" CornerRadius="2" Background="{Binding Info.Text}" Opacity="0.45" Margin="0,6,0,0" />
                                            <Border Height="4" Width="38" HorizontalAlignment="Left" CornerRadius="2" Background="{Binding Info.Text}" Opacity="0.45" Margin="0,4,0,0" />
                                            <Ellipse Width="12" Height="12" HorizontalAlignment="Right" Fill="{Binding Info.Accent}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Margin="6,9,0,0">
                                            <Border Height="3" Width="12" HorizontalAlignment="Left" CornerRadius="1" Background="{Binding Info.Text}" Opacity="0.5" />
                                            <Border Height="3" Width="10" HorizontalAlignment="Left" CornerRadius="1" Background="{Binding Info.Text}" Opacity="0.35" Margin="0,4,0,0" />
                                            <Border Height="3" Width="12" HorizontalAlignment="Left" CornerRadius="1" Background="{Binding Info.Accent}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                            <TextBlock x:Name="Label" Text="{Binding Info.Name}" FontSize="14" Margin="2,6,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text2Brush}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Text3Brush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- chip de columna (Estructura): activada = color de acento; desactivada = apagada, solo el contorno -->
        <Style x:Key="ColumnChip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,8" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="16" Padding="10,6" BorderThickness="1"
                                Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FolderRow" DataType="{x:Type vm:MusicFolderItem}">
            <Border x:Name="Bd" CornerRadius="6" Padding="10,8" Background="Transparent">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xED25;" FontSize="14" Click="OpenFolder_Click" ToolTip="Abrir en el Explorador" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="13" Click="RemoveFolder_Click" ToolTip="Quitar de la biblioteca (no borra nada)"
                                Margin="2,0,0,0" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text2Brush}" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Detail" Text="{Binding Detail}" FontSize="14" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Path}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource FavBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- la tarjeta entra y sale con un fundido, creciendo o encogiendo un poco (ver SettingsWindow.xaml.cs) -->
    <!-- la sombra va en una capa aparte: con el efecto sobre el contenido, el texto saldría borroso (sin ClearType) -->
    <Grid x:Name="Card" Margin="24" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" />
                <TranslateTransform x:Name="CardShift" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Border CornerRadius="10" Background="{DynamicResource PopupBrush}" Effect="{StaticResource PopupShadow}" />
        <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                CornerRadius="10" RenderOptions.ClearTypeHint="Enabled">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="24,18,14,0" MouseLeftButtonDown="Header_MouseDown" Background="Transparent">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="13" Click="Close_Click" ToolTip="Cerrar (Esc)" />
                <TextBlock Text="Ajustes" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="24,0,24,22">
                    <!-- ===== Apariencia ===== -->
                    <ContentControl Style="{StaticResource SectionHeader}" Content="Tema" Tag="&#xE790;" Margin="0,20,0,14" />
                    <ItemsControl x:Name="ThemeList" ItemTemplate="{StaticResource ThemeCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Más temas: desplegable con el resto, por grupos -->
                    <ToggleButton x:Name="MoreThemesToggle" Style="{StaticResource DisclosureToggle}" Content="Más temas" Margin="0,2,0,0" />
                    <ItemsControl x:Name="MoreThemes" Margin="0,6,0,0"
                                  Visibility="{Binding IsChecked, ElementName=MoreThemesToggle, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,4">
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Text2Brush}" Margin="2,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Themes}" ItemTemplate="{StaticResource ThemeCard}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox x:Name="AnimationsBox" Style="{StaticResource Switch}" Content="Animaciones (Ctrl+E)" Margin="0,12,0,0"
                              Click="Animations_Click" />

                    <!-- ===== Biblioteca ===== -->
                    <Border Style="{StaticResource SectionRule}" />
                    <ContentControl Style="{StaticResource SectionHeader}" Content="Carpetas de música" Tag="&#xE8B7;" />
                    <TextBlock Text="Cada carpeta aparece como un bloque propio en el panel lateral. Quitar una carpeta no borra nada del disco."
                               FontSize="14" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl x:Name="FolderList" ItemTemplate="{StaticResource FolderRow}" Margin="-10,0,-10,0" />
                    <TextBlock x:Name="NoFolders" Text="Aún no has añadido ninguna carpeta." FontSize="15" Foreground="{DynamicResource Text3Brush}"
                               Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" FontSize="16" Content="Añadir carpeta…" Click="AddFolder_Click" />
                        <Button Style="{StaticResource SecondaryButton}" FontSize="16" Content="Volver a escanear" Click="Rescan_Click" Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- ===== Títulos ===== -->
                    <Border Style="{StaticResource SectionRule}" />
                    <ContentControl Style="{StaticResource SectionHeader}" Content="Títulos de las canciones" Tag="&#xE8D2;" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PreferFileName}">
                        <StackPanel>
                            <TextBlock Text="Usar el nombre del archivo en lugar de los metadatos" />
                            <TextBlock Text="Muestra el nombre del archivo sin la extensión y ordena por él (los álbumes siguen el orden de los archivos, no el número de pista)."
                                       FontSize="13" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <!-- ===== Letras ===== -->
                    <Border Style="{StaticResource SectionRule}" />
                    <ContentControl Style="{StaticResource SectionHeader}" Content="Letras">
                        <ContentControl.Tag>
                            <!-- el mismo micro de cantar del botón de la letra -->
                            <Path Style="{StaticResource SingMicIcon}" Width="16" Height="16" StrokeThickness="1.3" Stroke="{DynamicResource AccentBrush}" />
                        </ContentControl.Tag>
                    </ContentControl>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OnlineLyrics}">
                        <StackPanel>
                            <TextBlock Text="Buscar letras en internet (LRCLIB)" />
                            <TextBlock Text="Si una canción no tiene letra en un .lrc ni en sus etiquetas, se busca sincronizada en lrclib.net. Solo se envían artista, título, álbum y duración; lo encontrado se guarda en tu PC para no volver a pedirlo."
                                       FontSize="13" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <!-- ===== Discord ===== -->
                    <Border Style="{StaticResource SectionRule}" />
                    <ContentControl Style="{StaticResource SectionHeader}" Content="Discord">
                        <ContentControl.Tag>
                            <!-- el logo de Discord, solo el contorno y con el color de acento del tema -->
                            <Path Style="{StaticResource DiscordIcon}" Stroke="{DynamicResource AccentBrush}" />
                        </ContentControl.Tag>
                    </ContentControl>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DiscordEnabled}">
                        <StackPanel>
                            <TextBlock Text="Mostrar en Discord lo que escuchas" />
                            <TextBlock Text="Tu perfil enseña la carátula, la canción, el artista, el álbum y por dónde va. Usa la app de Discord abierta en este PC: no hay que iniciar sesión en Echoplex. En pausa se mantiene un minuto y luego se quita."
                                       FontSize="13" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <StackPanel IsEnabled="{Binding DiscordEnabled}" Margin="0,18,0,0">
                        <StackPanel.Style>
                            <!-- con Discord apagado, sus opciones se ven atenuadas -->
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="En la lista de miembros" FontWeight="SemiBold" />
                        <TextBlock Text="Discord siempre pone «Escuchando a» delante; tú eliges lo que va detrás."
                                   FontSize="13" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <WrapPanel>
                            <RadioButton x:Name="DiscordShowArtist" Style="{StaticResource ColumnChip}" GroupName="DiscordShow" FontSize="13"
                                         Content="El artista" Tag="artist" Checked="DiscordShow_Checked" />
                            <RadioButton x:Name="DiscordShowTitle" Style="{StaticResource ColumnChip}" GroupName="DiscordShow" FontSize="13"
                                         Content="La canción" Tag="title" Checked="DiscordShow_Checked" />
                            <RadioButton x:Name="DiscordShowApp" Style="{StaticResource ColumnChip}" GroupName="DiscordShow" FontSize="13"
                                         Content="Echoplex" Tag="app" Checked="DiscordShow_Checked" />
                        </WrapPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DiscordPlayState}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Icono de reproducción sobre la carátula" />
                                <TextBlock Text="Un pequeño ▶ o ⏸ en la esquina de la carátula, según suene o esté en pausa. Quítalo si prefieres ver la carátula entera."
                                           FontSize="13" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="Carátulas" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="Discord solo enseña imágenes que estén en internet. Pon aquí el programa que sube cada carátula: recibe la ruta de la imagen por la entrada estándar y escribe su URL, igual que con foo_discord_rich. Sin programa sale el logo de Echoplex. Si usas foo_discord_rich, se aprovechan las carátulas que ya subiste con él."
                                   FontSize="13" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <TextBox x:Name="DiscordUploadBox" Style="{StaticResource DialogBox}" FontFamily="Consolas" FontSize="13"
                                 Text="{Binding DiscordUploadCommand, UpdateSourceTrigger=LostFocus}" KeyDown="DiscordUploadBox_KeyDown"
                                 ToolTip="Por ejemplo: C:\Python\python.exe &quot;C:\scripts\subir_caratula.py&quot;" />
                        <TextBlock Text="{Binding DiscordStatus}" FontSize="13" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding DiscordStatus, Converter={StaticResource NullVis}}" />
                    </StackPanel>

                    <!-- ===== Actualizaciones ===== -->
                    <Border Style="{StaticResource SectionRule}" />
                    <ContentControl Style="{StaticResource SectionHeader}" Content="Actualizaciones" Tag="&#xE895;" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- con versión nueva disponible: se elige (nada se instala solo) -->
                            <Button Style="{StaticResource PrimaryButton}" FontSize="16" Content="Actualizar ahora" Click="InstallUpdate_Click" Margin="0,0,8,0"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource NullVis}}"
                                    IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource Eq}, ConverterParameter=False}"
                                    ToolTip="Descarga e instala la versión nueva y reinicia Echoplex (la cola y la posición se conservan)" />
                            <Button Style="{StaticResource SecondaryButton}" FontSize="16" Content="Omitir esta versión" Click="SkipUpdate_Click" Margin="0,0,8,0"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource NullVis}}" ToolTip="No volver a avisar de esta versión" />
                            <Button Style="{StaticResource SecondaryButton}" FontSize="16" Content="Buscar ahora" Click="CheckUpdates_Click" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UpdateStatus, TargetNullValue='Busca versiones nuevas en GitHub cada vez que se abre.'}" FontSize="14"
                                       Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,2,12,0" />
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" Content="Buscar actualizaciones al abrir Echoplex (avisa y pregunta antes de instalar)" Margin="0,12,0,0"
                              IsChecked="{Binding AutoUpdate}" />
                    <!-- notas de esta versión, las mismas de la release de GitHub -->
                    <ToggleButton x:Name="ReleaseNotesToggle" Style="{StaticResource DisclosureToggle}" Margin="0,10,0,0" />
                    <Border x:Name="ReleaseNotesBox" Background="{DynamicResource CalloutBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,6,0,0"
                            Visibility="{Binding IsChecked, ElementName=ReleaseNotesToggle, Converter={StaticResource BoolVis}}" />

                    <!-- ===== Otros ===== -->
                    <Border Style="{StaticResource SectionRule}" />
                    <ContentControl Style="{StaticResource SectionHeader}" Content="Otros" Tag="&#xE712;" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" FontSize="16" Content="Mini reproductor (Ctrl+M)" Click="Mini_Click" />
                        <Button Style="{StaticResource SecondaryButton}" FontSize="16" Content="Carpeta de datos" Click="DataFolder_Click" Margin="8,0,0,0"
                                ToolTip="Ajustes, playlists e historial (%LocalAppData%)" />
                    </StackPanel>

                    <!-- ===== Estructura ===== -->
                    <Border Style="{StaticResource SectionRule}" />
                    <ContentControl Style="{StaticResource SectionHeader}" Content="Estructura" Tag="&#xE80A;" />
                    <TextBlock Text="Columnas de las listas de canciones, en el orden de tu tabla. Pulsa una para mostrarla u ocultarla; el orden y el ancho se cambian arrastrando la cabecera de la tabla."
                               FontSize="14" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <WrapPanel x:Name="ColumnSwitches" />
                    <Button Style="{StaticResource SecondaryButton}" FontSize="16" Content="Restablecer columnas" Click="ResetColumns_Click"
                            HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Orden, anchos y columnas visibles de fábrica" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        </Border>
    </Grid>
</Window>
