<Window x:Class="Echoplex.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Echoplex"
        xmlns:vm="clr-namespace:Echoplex.ViewModels"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Width="1040" Height="820" FontSize="14" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}" KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- cabecera de sección: icono en el color de acento (Tag: un glifo o un elemento) y el título grande y a todo contraste -->
        <Style x:Key="SectionHeader" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                <ContentPresenter Content="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="18"
                                                  TextElement.Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center" TextElement.FontSize="24"
                                              TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextBrush}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- la frase que explica de qué va la sección, bajo su título -->
        <Style x:Key="SectionLead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="52,0,0,18" />
        </Style>

        <!-- espacio entre una sección y la siguiente -->
        <Style x:Key="SectionGap" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Margin" Value="0,18,0,30" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- título de un apartado dentro de una sección (lo que sale debajo de la sección en la barra lateral) -->
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <!-- la tarjeta de cada apartado: agrupa sus opciones para que se vea qué va con qué -->
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CalloutBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,16,20,18" />
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>

        <!-- explicación bajo una opción -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- línea fina entre dos opciones de la misma tarjeta -->
        <Style x:Key="GroupRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Margin" Value="0,16" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- con su interruptor principal apagado, las opciones de debajo se ven atenuadas -->
        <Style x:Key="DimWhenDisabled" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== barra lateral: una sección (icono y nombre) y debajo sus apartados ===== -->
        <Style x:Key="NavSection" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" />
                            <!-- la marca de la sección en la que estás -->
                            <Border x:Name="Bar" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            <ContentPresenter Margin="12,0,10,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="{StaticResource True}">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavSub" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <!-- la guía vertical que une los apartados de una sección; se ilumina en el apartado en el que estás -->
                            <Border x:Name="Guide" Width="2" HorizontalAlignment="Left" Margin="21,0,0,0" Background="{DynamicResource CardBorderBrush}" />
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="30,1,0,1" />
                            <ContentPresenter Margin="42,0,8,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="{StaticResource True}">
                                <Setter TargetName="Guide" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- «Powered by» arriba a la derecha: lleva a GitHub -->
        <Style x:Key="BrandButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource HoverBrush}" CornerRadius="8" Padding="12,5,13,5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ImageBrush x:Key="ReyesMask" ImageSource="pack://application:,,,/Echoplex;component/Assets/reyes-mark.png" Stretch="Uniform" />

        <!-- un elemento de la barra lateral: la sección y, debajo, sus apartados -->
        <DataTemplate x:Key="NavTemplate" DataType="{x:Type local:SettingsNavItem}">
            <StackPanel Margin="0,0,0,2">
                <Button Style="{StaticResource NavSection}" Tag="{Binding IsActive}" Click="Nav_Click">
                    <DockPanel>
                        <ContentControl Width="22" Content="{Binding Icon}" Focusable="False" IsTabStop="False" Margin="0,0,10,0"
                                        HorizontalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}"
                                        FontSize="16" FontWeight="Normal" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Children}" Margin="0,1,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SettingsNavItem}">
                            <Button Style="{StaticResource NavSub}" Tag="{Binding IsActive}" Click="Nav_Click">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- desplegable con flecha (Claros, Oscuros, Ver cambios de la versión); Tag: texto secundario al lado, como el número de temas -->
        <Style x:Key="DisclosureToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="8,5,10,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" TextElement.FontWeight="{TemplateBinding FontWeight}" />
                                <TextBlock Foreground="{DynamicResource Text3Brush}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Normal"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- familia de temas dentro de Claros u Oscuros: el mismo desplegable, más discreto -->
        <Style x:Key="FamilyToggle" TargetType="ToggleButton" BasedOn="{StaticResource DisclosureToggle}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        </Style>

        <!-- tarjeta de tema: una miniatura de la app con sus colores -->
        <DataTemplate x:Key="ThemeCard" DataType="{x:Type local:ThemeOption}">
            <Button Click="Theme_Click" Cursor="Hand" Margin="0,0,10,10" ToolTip="{Binding Info.Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Width="110">
                            <Border x:Name="Frame" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource CardBorderBrush}" Padding="2">
                                <Border CornerRadius="6" Height="74" Background="{Binding Info.Bg}" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding Info.Sidebar}" CornerRadius="6,0,0,6" />
                                        <StackPanel Grid.Column="1" Margin="8,9,8,0">
                                            <Border Height="5" Width="34" HorizontalAlignment="Left" CornerRadius="2" Background="{Binding Info.Text}" />
                                            <Border Height="4" Width="46" HorizontalAlignment="Left" CornerRadius="2" Background="{Binding Info.Text}" Opacity="0.45" Margin="0,6,0,0" />
                                            <Border Height="4" Width="38" HorizontalAlignment="Left" CornerRadius="2" Background="{Binding Info.Text}" Opacity="0.45" Margin="0,4,0,0" />
                                            <Ellipse Width="12" Height="12" HorizontalAlignment="Right" Fill="{Binding Info.Accent}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Margin="6,9,0,0">
                                            <Border Height="3" Width="12" HorizontalAlignment="Left" CornerRadius="1" Background="{Binding Info.Text}" Opacity="0.5" />
                                            <Border Height="3" Width="10" HorizontalAlignment="Left" CornerRadius="1" Background="{Binding Info.Text}" Opacity="0.35" Margin="0,4,0,0" />
                                            <Border Height="3" Width="12" HorizontalAlignment="Left" CornerRadius="1" Background="{Binding Info.Accent}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                            <TextBlock x:Name="Label" Text="{Binding Info.Name}" FontSize="14" Margin="2,6,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text2Brush}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Text3Brush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- chip de columna (Estructura): activada = color de acento; desactivada = apagada, solo el contorno -->
        <Style x:Key="ColumnChip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,8" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="16" Padding="10,6" BorderThickness="1"
                                Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Ecualizador: deslizadores verticales finos (como los de la barra de reproducción) ===== -->
        <Style x:Key="EqTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EqSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="0.5" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="1" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Width="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" HorizontalAlignment="Center" Margin="0,7" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource EqTrackButton}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource EqTrackButton}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource AccentBrush}"
                                                         Stroke="{DynamicResource PopupBrush}" StrokeThickness="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- valor de una banda, que también se escribe: parece texto y al pasar el ratón o al escribir se ve la caja -->
        <Style x:Key="EqValueBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="33" />
            <Setter Property="Height" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="MaxLength" Value="6" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="ToolTip" Value="Escribe los dB (de −12 a +12) y pulsa Enter" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- una banda: el valor arriba (se puede escribir), el deslizador y la frecuencia abajo (doble clic: a 0 dB; rueda: medio dB) -->
        <DataTemplate x:Key="EqBandTemplate" DataType="{x:Type vm:EqBand}">
            <StackPanel Width="34" ToolTip="{Binding Tip}">
                <TextBox Style="{StaticResource EqValueBox}" Text="{Binding ValueText, Mode=OneWay}"
                         PreviewKeyDown="EqValue_PreviewKeyDown" LostKeyboardFocus="EqValue_LostFocus"
                         GotKeyboardFocus="EqValue_GotFocus" PreviewMouseLeftButtonDown="EqValue_MouseDown" />
                <Slider Style="{StaticResource EqSlider}" Height="150" Margin="0,6" HorizontalAlignment="Center"
                        Value="{Binding Value, Mode=TwoWay}" MouseDoubleClick="EqSlider_DoubleClick" PreviewMouseWheel="EqSlider_Wheel" />
                <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Text3Brush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FolderRow" DataType="{x:Type vm:MusicFolderItem}">
            <Border x:Name="Bd" CornerRadius="6" Padding="10,8" Background="Transparent">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xED25;" FontSize="14" Click="OpenFolder_Click" ToolTip="Abrir en el Explorador" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="13" Click="RemoveFolder_Click" ToolTip="Quitar de la biblioteca (no borra nada)"
                                Margin="2,0,0,0" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text2Brush}" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Detail" Text="{Binding Detail}" FontSize="14" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Path}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource FavBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- un PasswordBox con el aspecto de las cajas de texto de los diálogos -->
        <Style x:Key="DialogPassword" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{DynamicResource InputBrush}" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorderBrush}" Padding="8,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- la tarjeta entra y sale con un fundido, creciendo o encogiendo un poco (ver SettingsWindow.xaml.cs) -->
    <!-- la sombra va en una capa aparte: con el efecto sobre el contenido, el texto saldría borroso (sin ClearType) -->
    <Grid x:Name="Card" Margin="24" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" />
                <TranslateTransform x:Name="CardShift" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Border CornerRadius="12" Background="{DynamicResource PopupBrush}" Effect="{StaticResource PopupShadow}" />
        <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                CornerRadius="12" RenderOptions.ClearTypeHint="Enabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== barra lateral: secciones y apartados; marca dónde estás y lleva a cada sitio ===== -->
            <Border Background="{DynamicResource SidebarBrush}" CornerRadius="11,0,0,11" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,20,16,14" Background="Transparent"
                                MouseLeftButtonDown="Header_MouseDown">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,1,12,0" />
                        <TextBlock Text="Ajustes" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" FontSize="12" Foreground="{DynamicResource Text3Brush}"
                               Margin="24,8,16,14" TextTrimming="CharacterEllipsis" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl x:Name="NavList" ItemTemplate="{StaticResource NavTemplate}" Margin="12,0,12,8" Focusable="False" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1">
                <!-- arriba: dónde estás, la firma y cerrar (se arrastra la ventana desde aquí) -->
                <DockPanel DockPanel.Dock="Top" Margin="36,16,14,6" Height="40" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="13" Click="Close_Click"
                            ToolTip="Cerrar (Esc)" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BrandButton}" Click="Brand_Click" VerticalAlignment="Center"
                            ToolTip="github.com/Reyes-gh">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Powered by" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                            <Rectangle Width="16" Height="22" Margin="9,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource TextBrush}"
                                       OpacityMask="{StaticResource ReyesMask}" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Reyes-gh" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="Breadcrumb" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Text3Brush}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              ScrollChanged="ContentScroll_ScrollChanged">
                    <StackPanel x:Name="ContentPanel" Margin="36,14,36,0">

                    <!-- ================= Apariencia ================= -->
                    <ContentControl x:Name="SecAppearance" Style="{StaticResource SectionHeader}" Content="Apariencia" Tag="&#xE790;" />
                    <TextBlock Style="{StaticResource SectionLead}" Text="Los colores de Echoplex y cómo se mueve." />

                    <TextBlock x:Name="SubThemes" Style="{StaticResource SubHeader}" Text="Temas de Echoplex" />
                    <Border Style="{StaticResource Group}" Padding="20,18,10,8">
                        <ItemsControl x:Name="ThemeList" ItemTemplate="{StaticResource ThemeCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>

                    <!-- Más temas: desplegable con el resto, en Claros y Oscuros y por familias (que también se pliegan) -->
                    <TextBlock x:Name="SubMoreThemes" Style="{StaticResource SubHeader}" Text="Más temas" />
                    <Border Style="{StaticResource Group}" Padding="12,10,10,10">
                        <StackPanel>
                            <ToggleButton x:Name="MoreThemesToggle" Style="{StaticResource DisclosureToggle}" Content="Ver todos los temas" />
                            <ItemsControl x:Name="ThemeCategories" Margin="12,4,0,0"
                                          Visibility="{Binding IsChecked, ElementName=MoreThemesToggle, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ThemeGroup}">
                                        <StackPanel Margin="0,0,0,2">
                                            <ToggleButton Style="{StaticResource DisclosureToggle}" IsChecked="{Binding IsOpen}" Tag="{Binding Summary}" FontSize="15">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" FontWeight="Normal"
                                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ItemsControl ItemsSource="{Binding Groups}" Margin="20,2,0,6"
                                                          Visibility="{Binding IsOpen, Converter={StaticResource BoolVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:ThemeGroup}">
                                                        <StackPanel>
                                                            <ToggleButton Style="{StaticResource FamilyToggle}" Content="{Binding Name}" IsChecked="{Binding IsOpen}"
                                                                          Tag="{Binding Summary}" />
                                                            <ItemsControl ItemsSource="{Binding Themes}" ItemTemplate="{StaticResource ThemeCard}" Margin="8,6,0,4"
                                                                          Visibility="{Binding IsOpen, Converter={StaticResource BoolVis}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SubSeekBar" Style="{StaticResource SubHeader}" Text="Barra de progreso" />
                    <Border Style="{StaticResource Group}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WaveformSeek}">
                            <StackPanel>
                                <TextBlock Text="Forma de onda en la barra de progreso" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="La barra de abajo enseña la forma de la canción (los estribillos y las partes fuertes, a la vista antes de saltar). Se calcula al empezar cada canción del PC, sin prisa, y se guarda; las de la nube no la llevan." />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock x:Name="SubAnimations" Style="{StaticResource SubHeader}" Text="Animaciones" />
                    <Border Style="{StaticResource Group}">
                        <CheckBox x:Name="AnimationsBox" Style="{StaticResource Switch}" Click="Animations_Click">
                            <StackPanel>
                                <TextBlock Text="Animaciones (Ctrl+E)" />
                                <TextBlock Style="{StaticResource Hint}" Text="Transiciones entre páginas, luces de la pantalla completa y fundidos. Apágalas si prefieres que todo cambie al instante." />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <!-- ================= Biblioteca ================= -->
                    <Border Style="{StaticResource SectionGap}" />
                    <ContentControl x:Name="SecLibrary" Style="{StaticResource SectionHeader}" Content="Biblioteca" Tag="&#xE8F1;" />
                    <TextBlock Style="{StaticResource SectionLead}" Text="Qué música ve Echoplex y cómo te la enseña." />

                    <TextBlock x:Name="SubFolders" Style="{StaticResource SubHeader}" Text="Carpetas de música" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Cada carpeta aparece como un bloque propio en el panel lateral. Quitar una carpeta no borra nada del disco." />
                            <ItemsControl x:Name="FolderList" ItemTemplate="{StaticResource FolderRow}" Margin="-10,0,-10,0" />
                            <TextBlock x:Name="NoFolders" Text="Aún no has añadido ninguna carpeta." FontSize="15" Foreground="{DynamicResource Text3Brush}"
                                       Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" FontSize="15" Content="Añadir carpeta…" Click="AddFolder_Click" />
                                <Button Style="{StaticResource SecondaryButton}" FontSize="15" Content="Volver a escanear" Click="Rescan_Click" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- carpetas en línea: se escuchan desde la nube, sin copiar nada al PC -->
                    <TextBlock x:Name="SubOnline" Style="{StaticResource SubHeader}" Text="Carpetas en línea" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Pega la dirección de una carpeta compartida de Google Drive u OneDrive («Cualquier persona con el enlace»), del listado de carpetas de un servidor web o de un archivo de audio, y ponle el nombre que quieras: saldrá así en el panel lateral. Las canciones se escuchan directamente desde la nube; no se copia nada a tu PC." />
                            <ItemsControl x:Name="OnlineList" Margin="-10,0,-10,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OnlineFolderItem}">
                                        <Border x:Name="Bd" CornerRadius="6" Padding="10,8" Background="Transparent">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- conectada o desconectada (también con el mundo de su página) -->
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Click="OnlineEnabled_Click"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                                              ToolTip="Conectada: sus canciones se ven y suenan. Desconectada, sigue en el panel lateral pero no se ve ni suena nada de ella." />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" FontSize="13" Click="OpenOnline_Click"
                                                            ToolTip="Abrir en el navegador" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="13" Click="RemoveOnline_Click"
                                                            ToolTip="Quitar de la biblioteca (en la nube no se borra nada)" Margin="2,0,0,0" />
                                                </StackPanel>
                                                <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="Globe" Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" />
                                                    <Path x:Name="Strike" Data="M 2,2 L 18,18" Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                                    <!-- cargando: un arco que gira -->
                                                    <Path x:Name="Spinner" Visibility="Collapsed" Width="18" Height="18" Stretch="None" RenderTransformOrigin="0.5,0.5"
                                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M 9,1.5 A 7.5,7.5 0 1 1 1.5,9">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="SpinnerTurn" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="OnlineName" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="14" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}">
                                                        <Run Text="{Binding Detail, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Url, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter TargetName="Globe" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Spin">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="SpinnerTurn" Storyboard.TargetProperty="Angle"
                                                                             From="0" To="360" Duration="0:0:0.9" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Spin" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <!-- desconectada: el mundo tachado y el nombre apagado (sin icono de carga aunque algo siga en marcha) -->
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="Strike" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Globe" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Spinner" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="OnlineName" Property="Foreground" Value="{DynamicResource Text3Brush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource SecondaryButton}" FontSize="15" Click="AddOnline_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                                        <TextBlock Text="Añadir carpeta en línea…" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" FontSize="14" Content="Comprobar cambios" Click="RefreshOnline_Click" Margin="8,0,0,0"
                                        VerticalAlignment="Center" ToolTip="Vuelve a mirar qué hay en cada carpeta en línea" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SubTitles" Style="{StaticResource SubHeader}" Text="Títulos de las canciones" />
                    <Border Style="{StaticResource Group}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PreferFileName}">
                            <StackPanel>
                                <TextBlock Text="Usar el nombre del archivo en lugar de los metadatos" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Muestra el nombre del archivo sin la extensión y ordena por él (los álbumes siguen el orden de los archivos, no el número de pista)." />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock x:Name="SubColumns" Style="{StaticResource SubHeader}" Text="Columnas de las listas" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Columnas de las listas de canciones, en el orden de tu tabla. Pulsa una para mostrarla u ocultarla; el orden y el ancho se cambian arrastrando la cabecera de la tabla." />
                            <WrapPanel x:Name="ColumnSwitches" />
                            <Button Style="{StaticResource SecondaryButton}" FontSize="15" Content="Restablecer columnas" Click="ResetColumns_Click"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Orden, anchos y columnas visibles de fábrica" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OnlineBpm}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Buscar el BPM en internet (Deezer)" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Para la columna BPM (solo mientras se ve): si una canción no lo trae en sus etiquetas, se busca en deezer.com, poco a poco y en segundo plano. Solo se envían el artista y el título; lo encontrado se guarda en tu PC para no volver a pedirlo. El de las etiquetas manda siempre." />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AudioBpm}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Calcular el BPM escuchando el audio" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Para la columna BPM (solo mientras se ve), en las que no lo traen en sus etiquetas ni lo tiene Deezer. Las de tu PC se analizan en segundo plano, sin prisa y con la prioridad más baja; las de carpetas en línea, nada más darles a play, con la copia que se baja para reproducirlas (sin descargar nada aparte); y las que están solo en OneDrive, cuando suenan enteras, con el mismo audio que se reproduce. Si el cálculo no está seguro, sale con un aviso; alguna puede salir al doble o a la mitad." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SubHealth" Style="{StaticResource SubHeader}" Text="Salud de la biblioteca" />
                    <Border Style="{StaticResource Group}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" FontSize="14" Content="Revisar la biblioteca" Click="Health_Click" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,12,0" VerticalAlignment="Center"
                                       Text="Busca canciones repetidas, álbumes sin carátula, etiquetas que faltan, archivos que no se pueden leer y carpetas vacías. Solo los enseña: no cambia ni borra nada." />
                        </DockPanel>
                    </Border>

                    <!-- ================= Sonido ================= -->
                    <Border Style="{StaticResource SectionGap}" />
                    <ContentControl x:Name="SecSound" Style="{StaticResource SectionHeader}" Content="Sonido" Tag="&#xE9E9;" />
                    <TextBlock Style="{StaticResource SectionLead}" Text="Ajusta cómo suena la música." />

                    <TextBlock x:Name="SubEq" Style="{StaticResource SubHeader}" Text="Ecualizador" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EqEnabled}">
                                <StackPanel>
                                    <TextBlock Text="Activar ecualizador de 15 bandas" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Cada cambio se oye al momento, sin transiciones. Doble clic en una banda la deja a 0 dB. Tras hacer clic dentro del ecualizador, la rueda del ratón mueve medio dB la banda que tengas debajo." />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="Con «Bit a bit» activado el ecualizador no se aplica: la señal llega intacta a tu dispositivo."
                                       FontSize="13" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding Player.ExclusiveMode, Converter={StaticResource BoolVis}}" />
                            <StackPanel x:Name="EqPanel" Margin="0,16,0,0" IsEnabled="{Binding EqEnabled}">
                                <StackPanel.Style>
                                    <!-- apagado se ve atenuado y no responde a nada (ni clics ni rueda): solo el interruptor de arriba -->
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EqEnabled}" Value="False">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <WrapPanel x:Name="EqPresetChips" />
                                <!-- la rueda solo mueve bandas tras hacer clic aquí dentro (hasta que el ratón sale): si no, desplaza Ajustes -->
                                <Border x:Name="EqBox" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="8,12,8,10" Margin="0,6,0,0"
                                        PreviewMouseDown="EqBox_PreviewMouseDown" MouseLeave="EqBox_MouseLeave">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- línea de 0 dB y la curva que une las 15 bandas (sin el preamplificador), por debajo de los deslizadores;
                                             se dibujan en SettingsWindow.xaml.cs con cada cambio -->
                                        <Canvas x:Name="EqCurveCanvas" Grid.ColumnSpan="3" IsHitTestVisible="False" ClipToBounds="False">
                                            <Line x:Name="EqZeroLine" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1" Opacity="0.45" />
                                            <Path x:Name="EqCurveFill" Fill="{DynamicResource AccentBrush}" Opacity="0.12" />
                                            <Path x:Name="EqCurve" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0.9"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                        <ContentControl Content="{Binding EqPreamp}" ContentTemplate="{StaticResource EqBandTemplate}" Focusable="False" />
                                        <Border Grid.Column="1" Width="1" Background="{DynamicResource CardBorderBrush}" Margin="4,0,6,0" />
                                        <ItemsControl x:Name="EqBandsList" Grid.Column="2" ItemsSource="{Binding EqBands}" ItemTemplate="{StaticResource EqBandTemplate}"
                                                      HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Restablecer" Click="EqReset_Click"
                                            ToolTip="Todas las bandas y el preamplificador a 0 dB" />
                                    <TextBlock Text="±12 dB por banda: arrastra o escribe el valor. Si al subir bandas algo satura, baja el preamplificador."
                                               FontSize="12" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- la respuesta real: lo que sale de verdad, calculado de los filtros (se dibuja en SettingsWindow.xaml.cs) -->
                                <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14,10,14,8" Margin="0,14,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="EqHeadroomText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Text3Brush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="Respuesta real" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                                   Text="Lo que sale de verdad por los altavoces, calculado de los filtros (sin contar el preamplificador)." />
                                        <Canvas x:Name="EqResponseCanvas" Height="130" Margin="0,10,0,0" ClipToBounds="True" SizeChanged="EqResponse_SizeChanged" />
                                    </StackPanel>
                                </Border>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EqAutoHeadroom}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Margen automático contra la saturación" />
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Con bandas subidas, baja el volumen justo lo que sube la curva para que nunca sature: suena algo más bajo, pero limpio. Sin él, un limitador baja solo los picos que se pasarían de 0 dB." />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SubCrossfade" Style="{StaticResource SubHeader}" Text="Fundido entre canciones" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="La canción que acaba baja mientras sube la siguiente. En «Bit a bit» no se aplica." />
                            <WrapPanel>
                                <RadioButton x:Name="FadeOff" Style="{StaticResource ColumnChip}" GroupName="Crossfade" FontSize="13" Tag="0" Content="Apagado" Checked="Crossfade_Checked" />
                                <RadioButton x:Name="Fade3" Style="{StaticResource ColumnChip}" GroupName="Crossfade" FontSize="13" Tag="3" Content="3 s" Checked="Crossfade_Checked" />
                                <RadioButton x:Name="Fade6" Style="{StaticResource ColumnChip}" GroupName="Crossfade" FontSize="13" Tag="6" Content="6 s" Checked="Crossfade_Checked" />
                                <RadioButton x:Name="Fade9" Style="{StaticResource ColumnChip}" GroupName="Crossfade" FontSize="13" Tag="9" Content="9 s" Checked="Crossfade_Checked" />
                                <RadioButton x:Name="FadeCustom" Style="{StaticResource ColumnChip}" GroupName="Crossfade" FontSize="13" Tag="custom" Content="Otro"
                                             Checked="Crossfade_Checked" ToolTip="Los segundos que quieras, de 1 a 10" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"
                                            Visibility="{Binding IsChecked, ElementName=FadeCustom, Converter={StaticResource BoolVis}}">
                                    <TextBox x:Name="FadeCustomBox" Style="{StaticResource DialogBox}" Width="64" Height="30" FontSize="13" HorizontalContentAlignment="Center"
                                             LostKeyboardFocus="FadeCustomBox_LostFocus" KeyDown="FadeCustomBox_KeyDown" ToolTip="De 1 a 10 segundos (por ejemplo 4,5)" />
                                    <TextBlock Text="segundos" FontSize="13" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </WrapPanel>
                            <Border Style="{StaticResource GroupRule}" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CrossfadeAlbums}">
                                <StackPanel>
                                    <TextBlock Text="Fundir también las pistas seguidas de un mismo disco" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Apágalo para que un álbum escuchado en orden suene enlazado, sin fundidos, como se grabó (directos, álbumes conceptuales)." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SubNormalization" Style="{StaticResource SubHeader}" Text="Normalización de volumen" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Que todas las canciones suenen igual de fuertes, sin tocar el volumen al pasar de un disco antiguo a uno moderno. Usa las etiquetas ReplayGain de cada archivo y, si no las tiene, lo que mide Echoplex la primera vez que suena entera. Nunca sube tanto que sature. En «Bit a bit» no se aplica." />
                            <WrapPanel>
                                <RadioButton x:Name="NormOff" Style="{StaticResource ColumnChip}" GroupName="Normalization" FontSize="13" Tag="off"
                                             Content="Apagada" Checked="Normalization_Checked" />
                                <RadioButton x:Name="NormTrack" Style="{StaticResource ColumnChip}" GroupName="Normalization" FontSize="13" Tag="track"
                                             Content="Por canción" Checked="Normalization_Checked"
                                             ToolTip="Cada canción a la misma sonoridad" />
                                <RadioButton x:Name="NormAlbum" Style="{StaticResource ColumnChip}" GroupName="Normalization" FontSize="13" Tag="album"
                                             Content="Por álbum" Checked="Normalization_Checked"
                                             ToolTip="Cada álbum a la misma sonoridad, respetando las diferencias entre sus canciones (una intro flojita sigue siéndolo)" />
                                <RadioButton x:Name="NormSmart" Style="{StaticResource ColumnChip}" GroupName="Normalization" FontSize="13" Tag="smart"
                                             Content="Inteligente" Checked="Normalization_Checked"
                                             ToolTip="Por álbum si escuchas un álbum o una carpeta en orden; por canción en aleatorio, listas o radio" />
                            </WrapPanel>
                            <Border Style="{StaticResource GroupRule}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" FontSize="14" Click="Measure_Click" VerticalAlignment="Center"
                                        ToolTip="Decodifica las canciones del PC sin medida ni ReplayGain, de una en una y sin prisa (no le quita CPU a nada). Las de carpetas en línea se miden cuando suenan.">
                                    <TextBlock x:Name="MeasureButtonText" Text="Medir la biblioteca" />
                                </Button>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="NormSummary" Style="{StaticResource Hint}" Margin="0" />
                                    <TextBlock Text="{Binding MeasureStatus}" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding MeasureStatus, Converter={StaticResource NullVis}}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ================= Letras ================= -->
                    <Border Style="{StaticResource SectionGap}" />
                    <ContentControl x:Name="SecLyrics" Style="{StaticResource SectionHeader}" Content="Letras">
                        <ContentControl.Tag>
                            <!-- el mismo micro de cantar del botón de la letra -->
                            <Path Style="{StaticResource SingMicIcon}" Width="18" Height="18" StrokeThickness="1.3" Stroke="{DynamicResource AccentBrush}" />
                        </ContentControl.Tag>
                    </ContentControl>
                    <TextBlock Style="{StaticResource SectionLead}" Text="De dónde salen las letras que se ven mientras suena una canción." />

                    <TextBlock x:Name="SubOnlineLyrics" Style="{StaticResource SubHeader}" Text="Letras en internet" />
                    <Border Style="{StaticResource Group}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OnlineLyrics}">
                            <StackPanel>
                                <TextBlock Text="Buscar letras en internet (LRCLIB)" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Si una canción no tiene letra en un .lrc ni en sus etiquetas, se busca sincronizada en lrclib.net. Solo se envían artista, título, álbum y duración; lo encontrado se guarda en tu PC para no volver a pedirlo." />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <!-- ================= Discord ================= -->
                    <Border Style="{StaticResource SectionGap}" />
                    <ContentControl x:Name="SecDiscord" Style="{StaticResource SectionHeader}" Content="Discord">
                        <ContentControl.Tag>
                            <!-- el logo de Discord, solo el contorno y con el color de acento del tema -->
                            <Path Style="{StaticResource DiscordIcon}" Width="20" Height="20" Stroke="{DynamicResource AccentBrush}" />
                        </ContentControl.Tag>
                    </ContentControl>
                    <TextBlock Style="{StaticResource SectionLead}" Text="Lo que escuchas, en tu perfil de Discord." />

                    <TextBlock x:Name="SubDiscordStatus" Style="{StaticResource SubHeader}" Text="Estado en Discord" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DiscordEnabled}">
                                <StackPanel>
                                    <TextBlock Text="Mostrar en Discord lo que escuchas" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Tu perfil enseña la carátula, la canción, el artista, el álbum y por dónde va. Usa la app de Discord abierta en este PC: no hay que iniciar sesión en Echoplex. En pausa se mantiene un minuto y luego se quita." />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="{Binding DiscordStatus}" FontSize="13" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" Margin="46,10,0,0"
                                       Visibility="{Binding DiscordStatus, Converter={StaticResource NullVis}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SubDiscordList" Style="{StaticResource SubHeader}" Text="En la lista de miembros" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel Style="{StaticResource DimWhenDisabled}" IsEnabled="{Binding DiscordEnabled}">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="Discord siempre pone «Escuchando a» delante; tú eliges lo que va detrás." />
                            <WrapPanel>
                                <RadioButton x:Name="DiscordShowArtist" Style="{StaticResource ColumnChip}" GroupName="DiscordShow" FontSize="13"
                                             Content="El artista" Tag="artist" Checked="DiscordShow_Checked" />
                                <RadioButton x:Name="DiscordShowTitle" Style="{StaticResource ColumnChip}" GroupName="DiscordShow" FontSize="13"
                                             Content="La canción" Tag="title" Checked="DiscordShow_Checked" />
                                <RadioButton x:Name="DiscordShowApp" Style="{StaticResource ColumnChip}" GroupName="DiscordShow" FontSize="13"
                                             Content="Echoplex" Tag="app" Checked="DiscordShow_Checked" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SubDiscordCovers" Style="{StaticResource SubHeader}" Text="Carátulas" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel Style="{StaticResource DimWhenDisabled}" IsEnabled="{Binding DiscordEnabled}">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                       Text="Discord solo enseña imágenes que estén en internet. De serie, Echoplex busca la carátula de cada álbum en Deezer e iTunes, gratis y sin cuentas: solo se envían el artista y el álbum. Si no encuentra la del álbum exacto, sale el logo de Echoplex." />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DiscordPlayState}">
                                <StackPanel>
                                    <TextBlock Text="Icono de reproducción sobre la carátula" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Un pequeño ▶ o ⏸ en la esquina de la carátula, según suene o esté en pausa. Quítalo si prefieres ver la carátula entera." />
                                </StackPanel>
                            </CheckBox>
                            <Border Style="{StaticResource GroupRule}" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DiscordManualCovers}">
                                <StackPanel>
                                    <TextBlock Text="Carátulas manuales: subirlas con tu propio programa" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Echoplex le pasa la imagen de cada carátula a tu programa, que la sube donde quieras y escribe su URL, igual que con foo_discord_rich. Las URL se guardan en un JSON local, se aprovechan las que ya subiste con foo_discord_rich y puedes cambiar una con «Actualizar carátula en Discord» (clic derecho en cualquier carátula)." />
                                </StackPanel>
                            </CheckBox>
                            <TextBox x:Name="DiscordUploadBox" Style="{StaticResource DialogBox}" FontFamily="Consolas" FontSize="13" Margin="46,10,0,0"
                                     Text="{Binding DiscordUploadCommand, UpdateSourceTrigger=LostFocus}" KeyDown="DiscordUploadBox_KeyDown"
                                     Visibility="{Binding DiscordManualCovers, Converter={StaticResource BoolVis}}"
                                     ToolTip="Tu programa de subida. Por ejemplo: C:\Programas\subir.exe &quot;--modo imagen&quot;" />
                        </StackPanel>
                    </Border>

                    <!-- ================= Scrobbling ================= -->
                    <Border Style="{StaticResource SectionGap}" />
                    <ContentControl x:Name="SecScrobble" Style="{StaticResource SectionHeader}" Content="Scrobbling" Tag="&#xE81C;" />
                    <TextBlock Style="{StaticResource SectionLead}" Text="Tu historial de escuchas en Last.fm o ListenBrainz, para tus estadísticas y recomendaciones." />

                    <TextBlock x:Name="SubLastFm" Style="{StaticResource SubHeader}" Text="Last.fm" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <DockPanel Visibility="{Binding LastFmUser, Converter={StaticResource NullVis}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" FontSize="14" Content="Desconectar" Click="LastFmDisconnect_Click" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock FontWeight="SemiBold"><Run Text="Conectado como " /><Run Text="{Binding LastFmUser, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                               Text="Cada canción que escuchas al menos la mitad (o 4 minutos) se apunta en tu perfil, y mientras suena sale como «Escuchando ahora». Solo se envían el artista, la canción, el álbum y su duración." />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Visibility="{Binding LastFmUser, Converter={StaticResource NullVis}, ConverterParameter=invert}">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="Last.fm pide una clave de API propia. Créala gratis en last.fm/api/account/create (pon cualquier nombre de aplicación) y pega aquí su «API key» y su «Shared secret». Al pulsar Conectar se abre Last.fm en el navegador para dar permiso. Se guardan cifradas con tu cuenta de Windows." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="API key" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0" />
                                    <TextBox x:Name="LastFmKeyBox" Grid.Column="1" Style="{StaticResource DialogBox}" FontFamily="Consolas" FontSize="13"
                                             Text="{Binding LastFmApiKey, Mode=OneWay}" />
                                    <TextBlock Grid.Row="1" Text="Shared secret" VerticalAlignment="Center" FontSize="14" Margin="0,8,12,0" />
                                    <PasswordBox x:Name="LastFmSecretBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource DialogPassword}" Margin="0,8,0,0" />
                                </Grid>
                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" FontSize="14" Content="Conectar" Click="LastFmConnect_Click" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LastFmStatus}" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                </DockPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding LastFmStatus}" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding LastFmUser, Converter={StaticResource NullVis}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SubListenBrainz" Style="{StaticResource SubHeader}" Text="ListenBrainz" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <DockPanel Visibility="{Binding ListenBrainzUser, Converter={StaticResource NullVis}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" FontSize="14" Content="Desconectar" Click="ListenBrainzDisconnect_Click" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock FontWeight="SemiBold"><Run Text="Conectado como " /><Run Text="{Binding ListenBrainzUser, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                               Text="Libre y sin ánimo de lucro (de MetaBrainz, los de MusicBrainz). Mismas reglas que Last.fm: la mitad de la canción o 4 minutos." />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Visibility="{Binding ListenBrainzUser, Converter={StaticResource NullVis}, ConverterParameter=invert}">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="Libre y sin ánimo de lucro (de MetaBrainz, los de MusicBrainz). Pega tu token de usuario, que está en listenbrainz.org/settings. Se guarda cifrado con tu cuenta de Windows." />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" FontSize="14" Content="Conectar" Click="ListenBrainzConnect_Click" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <PasswordBox x:Name="ListenBrainzTokenBox" Style="{StaticResource DialogPassword}" />
                                </DockPanel>
                                <TextBlock Text="{Binding ListenBrainzStatus}" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding ListenBrainzStatus, Converter={StaticResource NullVis}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ListenBrainzStatus}" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding ListenBrainzUser, Converter={StaticResource NullVis}}" />
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,10,0,0" Visibility="{Binding ScrobbleStatus, Converter={StaticResource NullVis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" FontSize="13" Content="Enviar ahora" Click="ScrobbleFlush_Click" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ScrobbleStatus}" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- ================= Móvil ================= -->
                    <Border Style="{StaticResource SectionGap}" />
                    <ContentControl x:Name="SecMobile" Style="{StaticResource SectionHeader}" Content="Móvil" Tag="&#xE8EA;" />
                    <TextBlock Style="{StaticResource SectionLead}" Text="Tu música de Echoplex en el móvil, en streaming y sin copiarla." />

                    <TextBlock x:Name="SubMobileServer" Style="{StaticResource SubHeader}" Text="Acceso desde el móvil" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RemoteEnabled}">
                                <StackPanel>
                                    <TextBlock Text="Dejar que el móvil escuche tu biblioteca" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Echoplex hace de servidor compatible con Subsonic: en el móvil sirve una app como Tempus (Android, gratis y de código abierto) o Symfonium. Funciona mientras Echoplex esté abierto, también escondido en la bandeja. La primera vez, Windows preguntará si dejas que Echoplex use la red: acepta en redes privadas." />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Style="{StaticResource DimWhenDisabled}" IsEnabled="{Binding RemoteEnabled}" Margin="46,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="En casa" FontSize="14" Margin="0,8,14,0" VerticalAlignment="Top" />
                                    <TextBox Grid.Column="1" Text="{Binding RemoteAddresses, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"
                                             ToolTip="Para el móvil en el wifi de casa (en Tempus, «Local URL»; si hay varias, la de tu wifi o tu cable)" />
                                    <TextBlock Grid.Row="1" Text="Fuera de casa" FontSize="14" Margin="0,12,14,0" VerticalAlignment="Top" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                        <TextBox Text="{Binding RemoteAwayAddress, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                                 Visibility="{Binding RemoteAwayAddress, Converter={StaticResource NullVis}}"
                                                 ToolTip="Por Tailscale, desde cualquier sitio (en Tempus, «Server URL»)" />
                                        <!-- el Tailscale de Echoplex (paquete fuera de casa): descargar, iniciar sesión, cerrarla o quitarlo -->
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{Binding RemoteTsText}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Style="{StaticResource SecondaryButton}" FontSize="13" Content="Descargar el paquete fuera de casa" Click="TsDownload_Click" Margin="0,0,6,6"
                                                    Visibility="{Binding RemoteTsCanDownload, Converter={StaticResource BoolVis}}" />
                                            <Button Style="{StaticResource SecondaryButton}" FontSize="13" Content="Iniciar sesión en Tailscale" Click="TsLogin_Click" Margin="0,0,6,6"
                                                    Visibility="{Binding RemoteTsCanLogin, Converter={StaticResource BoolVis}}" />
                                            <Button Style="{StaticResource GhostButton}" FontSize="13" Content="Cerrar sesión" Click="TsLogout_Click" Margin="0,0,6,6"
                                                    Visibility="{Binding RemoteTsConnected, Converter={StaticResource BoolVis}}"
                                                    ToolTip="Este PC sale de tu red de Tailscale; para volver, inicia sesión otra vez" />
                                            <Button Style="{StaticResource GhostButton}" FontSize="13" Content="Quitar el paquete" Click="TsRemove_Click" Margin="0,0,6,6"
                                                    Visibility="{Binding RemoteTsInstalled, Converter={StaticResource BoolVis}}"
                                                    ToolTip="Lo borra de este PC, con la sesión de Tailscale" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="Usuario" FontSize="14" Margin="0,10,14,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource DialogBox}" FontFamily="Consolas" FontSize="13" Margin="0,10,0,0"
                                             Text="{Binding RemoteUser, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="3" Text="Contraseña" FontSize="14" Margin="0,10,14,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource DialogBox}" FontFamily="Consolas" FontSize="13" Margin="0,10,0,0"
                                             Text="{Binding RemotePassword, Mode=OneWay}" IsReadOnly="True" />
                                    <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="8,10,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" FontSize="13" Content="Copiar" Click="RemoteCopyPassword_Click" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource GhostButton}" FontSize="13" Content="Nueva" Click="RemoteNewPassword_Click"
                                                ToolTip="Otra contraseña: los móviles conectados tendrán que poner la nueva" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Text="Puerto" FontSize="14" Margin="0,10,14,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource DialogBox}" FontFamily="Consolas" FontSize="13" Margin="0,10,0,0" Width="90"
                                             HorizontalAlignment="Left" Text="{Binding RemotePort, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <Button x:Name="RemoteQrButton" Style="{StaticResource PrimaryButton}" FontSize="14" HorizontalAlignment="Left" Margin="0,16,0,0"
                                        Content="Mostrar QR para la app Echoplex" Click="RemoteQr_Click" />
                                <StackPanel x:Name="RemoteQrPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                    <Border Background="White" CornerRadius="8" Padding="10">
                                        <Image x:Name="RemoteQrImage" Width="220" Height="220" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <TextBlock Style="{StaticResource Hint}" Width="260" Margin="16,0,0,0" VerticalAlignment="Center"
                                               Text="Escanéalo con la app Echoplex del móvil: lleva la dirección de casa, la de fuera (si tienes Tailscale), el usuario y la contraseña, así que no hay que escribir nada. No lo enseñes a nadie: con él se entra en tu música. Si alguna vez se ve, pulsa «Nueva» en la contraseña." />
                                </StackPanel>
                                <TextBlock Text="Calidad fuera de casa" FontSize="14" Margin="0,16,0,6" />
                                <WrapPanel>
                                    <RadioButton x:Name="AwayOriginal" Style="{StaticResource ColumnChip}" GroupName="AwayQuality" FontSize="13" Tag="0" Content="Original" Checked="AwayQuality_Checked"
                                                 ToolTip="El archivo tal cual (un FLAC ocupa unos 30–40 MB por canción)" />
                                    <RadioButton x:Name="Away320" Style="{StaticResource ColumnChip}" GroupName="AwayQuality" FontSize="13" Tag="320" Content="MP3 320 kbps" Checked="AwayQuality_Checked" />
                                    <RadioButton x:Name="Away192" Style="{StaticResource ColumnChip}" GroupName="AwayQuality" FontSize="13" Tag="192" Content="MP3 192 kbps" Checked="AwayQuality_Checked"
                                                 ToolTip="Unos 5–6 MB por canción: suena muy bien y gasta poco" />
                                    <RadioButton x:Name="Away128" Style="{StaticResource ColumnChip}" GroupName="AwayQuality" FontSize="13" Tag="128" Content="MP3 128 kbps" Checked="AwayQuality_Checked" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Fuera de casa (por Tailscale), Echoplex convierte las canciones a MP3 sobre la marcha para gastar menos datos y que no se corte. En casa van siempre tal cual. Si la app pide otra calidad (en Tempus, ajustes de transcodificación), manda la de la app." />
                                <TextBlock Text="{Binding RemoteStatus}" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                                           Visibility="{Binding RemoteStatus, Converter={StaticResource NullVis}}" />
                                <TextBlock Text="{Binding RemoteLastAccess}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Visibility="{Binding RemoteLastAccess, Converter={StaticResource NullVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SubMobileHowTo" Style="{StaticResource SubHeader}" Text="Cómo conectarse" />
                    <Border Style="{StaticResource Group}">
                        <TextBlock Style="{StaticResource Hint}" Margin="0" LineHeight="21"
                                   Text="1. En el móvil, abre la app (por ejemplo Tempus) y añade un servidor con el usuario y la contraseña de arriba.&#x0a;2. Solo en casa: pon la dirección «En casa» como dirección del servidor.&#x0a;3. También fuera de casa, con Tailscale en el PC y en el móvil: pon la de «Fuera de casa» como dirección del servidor (en Tempus, «Server URL») y la de casa como dirección local («Local URL»). En tu wifi irá directo y fuera, por Tailscale.&#x0a;4. Lo que escuches en el móvil cuenta en Tu resumen y en tu historial, y las favoritas y playlists son las mismas.&#x0a;Echoplex no abre nada a internet por su cuenta. Si desde fuera no conecta, permite a Echoplex en el Firewall de Windows también para la red de Tailscale." />
                    </Border>

                    <!-- ================= General ================= -->
                    <Border Style="{StaticResource SectionGap}" />
                    <ContentControl x:Name="SecGeneral" Style="{StaticResource SectionHeader}" Content="General" Tag="&#xE770;" />
                    <TextBlock Style="{StaticResource SectionLead}" Text="Cómo se comporta la ventana y accesos rápidos." />

                    <TextBlock x:Name="SubCloseAction" Style="{StaticResource SubHeader}" Text="Al pulsar la X" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Cerrar sale de Echoplex del todo. Esconderlo lo deja junto al reloj, en la flecha de los iconos ocultos, y la música sigue: se vuelve con un clic en su icono y se sale con «Salir» en su menú." />
                            <WrapPanel>
                                <RadioButton x:Name="CloseExitChip" Style="{StaticResource ColumnChip}" GroupName="CloseAction" FontSize="13"
                                             Content="Cerrar Echoplex" Checked="CloseAction_Checked" />
                                <RadioButton x:Name="CloseTrayChip" Style="{StaticResource ColumnChip}" GroupName="CloseAction" FontSize="13"
                                             Content="Esconderlo en la bandeja" Checked="CloseAction_Checked" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SubGlobalKeys" Style="{StaticResource SubHeader}" Text="Atajos globales" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GlobalHotkeysOn}">
                                <StackPanel>
                                    <TextBlock Text="Controlar Echoplex desde cualquier programa" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Funcionan con Echoplex en segundo plano o escondido en la bandeja, también jugando. Las teclas multimedia del teclado van siempre, sin activar esto." />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Style="{StaticResource DimWhenDisabled}" IsEnabled="{Binding GlobalHotkeysOn}" Margin="46,12,0,0">
                                <WrapPanel>
                                    <RadioButton x:Name="HotkeyCtrlAlt" Style="{StaticResource ColumnChip}" GroupName="HotkeyMods" FontSize="13"
                                                 Content="Ctrl + Alt" Tag="no" Checked="HotkeyMods_Checked" />
                                    <RadioButton x:Name="HotkeyCtrlAltShift" Style="{StaticResource ColumnChip}" GroupName="HotkeyMods" FontSize="13"
                                                 Content="Ctrl + Alt + Mayús" Tag="shift" Checked="HotkeyMods_Checked"
                                                 ToolTip="Por si otro programa ya usa Ctrl + Alt con esas teclas (algunas gráficas giran la pantalla con Ctrl + Alt + flechas)" />
                                </WrapPanel>
                                <TextBlock Text="{Binding HotkeyHelp}" Style="{StaticResource Hint}" Margin="0,10,0,0" LineHeight="20" />
                                <TextBlock Text="{Binding HotkeyStatus}" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding HotkeyStatus, Converter={StaticResource NullVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SubShortcuts" Style="{StaticResource SubHeader}" Text="Accesos" />
                    <Border Style="{StaticResource Group}">
                        <WrapPanel>
                            <Button Style="{StaticResource SecondaryButton}" FontSize="15" Content="Mini reproductor (Ctrl+M)" Click="Mini_Click" Margin="0,0,8,0" />
                            <Button Style="{StaticResource SecondaryButton}" FontSize="15" Content="Carpeta de datos" Click="DataFolder_Click" Margin="0,0,8,0"
                                    ToolTip="Ajustes, playlists e historial (%LocalAppData%)" />
                            <Button Style="{StaticResource SecondaryButton}" FontSize="15" Click="GitHub_Click"
                                    ToolTip="La página de Echoplex en GitHub: código, versiones y novedades">
                                <StackPanel Orientation="Horizontal">
                                    <!-- la marca de GitHub (mark-github de Octicons, licencia MIT), del color del texto del botón -->
                                    <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
                                    <TextBlock Text="GitHub" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>

                    <!-- ================= Actualizaciones ================= -->
                    <Border Style="{StaticResource SectionGap}" />
                    <ContentControl x:Name="SecUpdates" Style="{StaticResource SectionHeader}" Content="Actualizaciones" Tag="&#xE895;" />
                    <TextBlock Style="{StaticResource SectionLead}" Text="Tu versión de Echoplex y las novedades." />

                    <TextBlock x:Name="SubVersion" Style="{StaticResource SubHeader}" Text="Versión" />
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- con versión nueva disponible: se elige (nada se instala solo) -->
                                    <Button Style="{StaticResource PrimaryButton}" FontSize="15" Content="Actualizar ahora" Click="InstallUpdate_Click" Margin="0,0,8,0"
                                            Visibility="{Binding UpdateAvailable, Converter={StaticResource NullVis}}"
                                            IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource Eq}, ConverterParameter=False}"
                                            ToolTip="Descarga e instala la versión nueva y reinicia Echoplex (la cola y la posición se conservan)" />
                                    <Button Style="{StaticResource SecondaryButton}" FontSize="15" Content="Omitir esta versión" Click="SkipUpdate_Click" Margin="0,0,8,0"
                                            Visibility="{Binding UpdateAvailable, Converter={StaticResource NullVis}}" ToolTip="No volver a avisar de esta versión" />
                                    <Button Style="{StaticResource SecondaryButton}" FontSize="15" Content="Buscar ahora" Click="CheckUpdates_Click" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UpdateStatus, TargetNullValue='Busca versiones nuevas en GitHub cada vez que se abre.'}"
                                               Style="{StaticResource Hint}" Margin="0,2,12,0" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource GroupRule}" />
                            <CheckBox Style="{StaticResource Switch}" Content="Buscar actualizaciones al abrir Echoplex (avisa y pregunta antes de instalar)"
                                      IsChecked="{Binding AutoUpdate}" />
                        </StackPanel>
                    </Border>

                    <!-- notas de esta versión, las mismas de la release de GitHub -->
                    <TextBlock x:Name="SubReleaseNotes" Style="{StaticResource SubHeader}" Text="Novedades" />
                    <Border x:Name="ReleaseNotesGroup" Style="{StaticResource Group}" Padding="12,10,12,12">
                        <StackPanel>
                            <ToggleButton x:Name="ReleaseNotesToggle" Style="{StaticResource DisclosureToggle}" />
                            <Border x:Name="ReleaseNotesBox" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,8,0,0"
                                    Visibility="{Binding IsChecked, ElementName=ReleaseNotesToggle, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- hueco al final: así la última sección también puede subir hasta arriba al elegirla en la barra lateral -->
                    <Border x:Name="BottomSpacer" Height="0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
        </Border>
    </Grid>
</Window>
