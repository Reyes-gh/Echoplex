<Window x:Class="Echoplex.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Echoplex — mini reproductor" Width="380" Height="132" Topmost="True" PreviewMouseWheel="Window_PreviewMouseWheel"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
    <Window.Resources>
        <!-- esquina para cambiar el tamaño: casi transparente (si no, la ventana transparente no recibiría el ratón ahí) -->
        <Style x:Key="MiniGrip" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="Arrastra para cambiar el tamaño (Ctrl + rueda también; doble clic: el de siempre)" />
            <EventSetter Event="DragStarted" Handler="Grip_DragStarted" />
            <EventSetter Event="DragDelta" Handler="Grip_DragDelta" />
            <EventSetter Event="DragCompleted" Handler="Grip_DragCompleted" />
            <EventSetter Event="MouseDoubleClick" Handler="Grip_DoubleClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#01FFFFFF" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Neoplex: todo a escala (esquinas o Ctrl + rueda); el margen de la sombra no cambia -->
    <Grid>
    <!-- sombra en una capa aparte: con el efecto sobre el contenido, el texto saldría borroso (sin ClearType) -->
    <Grid x:Name="Root" Margin="10" Width="360" Height="112">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" />
        </Grid.LayoutTransform>
    <Border CornerRadius="10" Background="{DynamicResource BgBrush}" Effect="{StaticResource PopupShadow}" />
    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
            CornerRadius="10" MouseLeftButtonDown="Drag" RenderOptions.ClearTypeHint="Enabled">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="90" Height="90">
                <Border CornerRadius="6" Background="{DynamicResource PlaceholderBrush}">
                    <Rectangle Style="{StaticResource NoteLogo}" Width="34" Height="34" />
                </Border>
                <Border CornerRadius="6" Visibility="{Binding NowPlayingCover, Converter={StaticResource NullVis}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding NowPlayingCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border.Background>
                </Border>
            </Grid>
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource IconButton}" Content="&#xE740;" FontSize="12" Width="24" Height="24" Click="Expand_Click"
                                ToolTip="Volver a la ventana completa" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="24" Height="24" Click="Close_Click"
                                ToolTip="Cerrar mini reproductor" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Player.Current.Title, FallbackValue=Nada sonando}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Player.Current.Artist}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-4,0,0,0">
                    <Button Style="{StaticResource IconButton}" Content="{Binding Player.Current.IsFavorite, Converter={StaticResource HeartGlyph}}"
                            Click="Fav_Click" ToolTip="Favorita" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" Margin="4,0,0,0" />
                    <Button Style="{StaticResource PlayCircleButton}" Content="{Binding Player.PlayGlyph}" Click="Play_Click" Width="30" Height="30"
                            Margin="6,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" />
                </StackPanel>
                <Slider x:Name="Seek" Grid.Row="2" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="{Binding Player.Duration}"
                        Value="{Binding Player.Position, Mode=OneWay}" IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
    </Grid>
    <!-- Neoplex: las cuatro esquinas cambian el tamaño (la contraria se queda quieta); doble clic, el de siempre -->
    <Grid Visibility="{Binding MiniResizable, Converter={StaticResource BoolVis}}">
        <Thumb Tag="tl" Style="{StaticResource MiniGrip}" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" />
        <Thumb Tag="tr" Style="{StaticResource MiniGrip}" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" />
        <Thumb Tag="bl" Style="{StaticResource MiniGrip}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" />
        <Thumb Tag="br" Style="{StaticResource MiniGrip}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" />
    </Grid>
    </Grid>
</Window>
