<Window x:Class="Echoplex.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
            CornerRadius="10" Margin="24" Padding="24,20" Width="440" Effect="{StaticResource PopupShadow}">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" FontSize="14" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="0,8,0,0"
                       LineHeight="21" />
            <TextBox x:Name="Input" Style="{StaticResource DialogBox}" Margin="0,16,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancelar" Click="Cancel_Click" MinWidth="84" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="Aceptar" Click="Ok_Click" Margin="8,0,0,0" MinWidth="84" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
