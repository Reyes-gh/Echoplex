<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Sin la proyección del SDK de Windows (~24 MB): los controles multimedia se llaman por su ABI (MediaControls.cs). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Echoplex</AssemblyName>
    <RootNamespace>Echoplex</RootNamespace>
    <ApplicationIcon>Assets\echoplex.ico</ApplicationIcon>
    <Product>Echoplex</Product>
    <Description>Reproductor de música local para Windows</Description>
    <Version>2.0.2</Version>
    <!-- la app de Android vive en android/: no es parte de este proyecto -->
    <DefaultItemExcludes>$(DefaultItemExcludes);android/**;tailscale/**</DefaultItemExcludes>
    <!-- las dependencias no traen traducciones que usemos: nada de carpetas de idiomas en la release -->
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- ILLink para publish.ps1, que recorta las librerías de terceros: solo se descarga, no forma parte del programa -->
    <PackageDownload Include="Microsoft.NET.ILLink.Tasks" Version="[8.0.19]" />
  </ItemGroup>

  <ItemGroup>
    <!-- el icono va solo en Echoplex.exe (ApplicationIcon): las ventanas sin Icon usan el del ejecutable -->
    <Resource Include="Assets\echoplex-logo.png" />
    <Resource Include="Assets\echoplex-logo-light.png" />
    <Resource Include="Assets\note.png" />
    <Resource Include="Assets\reyes-mark.png" />
    <!-- notas de esta versión (las de su release de GitHub): Ajustes → Actualizaciones → Ver cambios de la versión -->
    <EmbeddedResource Include=".github\notas\$(Version).md" LogicalName="notas/$(Version).md" Condition="Exists('.github\notas\$(Version).md')" />
  </ItemGroup>

</Project>
