<UserControl x:Class="Echoplex.VolumePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Echoplex"
             Focusable="True" FocusVisualStyle="{x:Null}" Foreground="{DynamicResource TextBrush}"
             PreviewMouseWheel="Panel_MouseWheel" PreviewKeyDown="Panel_KeyDown">
    <UserControl.Resources>
        <!-- tramo de la barra (0–5, 0–10…): texto separado por "|", subrayado el elegido -->
        <Style x:Key="RangeTab" TargetType="local:RangeOption">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:RangeOption">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="2,2,2,5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Line" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}"
                                    Opacity="0" Margin="2,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsAvailable" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Line" Property="Opacity" Value="0.35" />
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Line" Property="Opacity" Value="1" />
                            </Trigger>
                            <!-- el volumen actual no cabe en este tramo: atenuado y con el cursor de prohibido -->
                            <Trigger Property="IsAvailable" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- botón de paso fino (−1, −0,1…) -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- cabecera: título y silencio -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{Binding Player.VolumeGlyph}" Click="Mute_Click"
                    ToolTip="Silenciar" />
            <TextBlock Text="Volumen" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- lectura grande -->
        <DockPanel Margin="0,2,0,12">
            <TextBlock x:Name="DbText" DockPanel.Dock="Right" FontSize="13" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Bottom"
                       Margin="0,0,2,7" FontFamily="Consolas, Segoe UI" />
            <TextBlock VerticalAlignment="Bottom">
                <Run x:Name="PercentRun" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="SemiBold" /><Run Text=" %"
                     FontSize="20" Foreground="{DynamicResource Text2Brush}" />
            </TextBlock>
        </DockPanel>

        <!-- rango de la barra: cuanto más pequeño, más precisión -->
        <StackPanel x:Name="RangePanel" Orientation="Horizontal" Margin="0,0,0,12" />

        <!-- barra de precisión -->
        <Grid x:Name="Track" Height="30" Background="Transparent" Cursor="Hand" SizeChanged="Track_SizeChanged"
              MouseLeftButtonDown="Track_MouseDown" MouseMove="Track_MouseMove" MouseLeftButtonUp="Track_MouseUp" LostMouseCapture="Track_LostCapture">
            <Border Height="8" CornerRadius="4" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" />
            <Border x:Name="Fill" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                    HorizontalAlignment="Left" Width="0" />
            <Canvas x:Name="Ticks" IsHitTestVisible="False" />
            <Ellipse x:Name="Thumb" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}"
                     Stroke="{DynamicResource PopupBrush}" StrokeThickness="3">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.35" Color="#000000" />
                </Ellipse.Effect>
            </Ellipse>
        </Grid>
        <Grid Margin="0,2,0,0">
            <TextBlock x:Name="MinLabel" Text="0" FontSize="11.5" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Left" />
            <TextBlock x:Name="MidLabel" FontSize="11.5" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="MaxLabel" FontSize="11.5" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Right" />
        </Grid>

        <!-- pasos finos y valor exacto -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource StepButton}" Content="−1" Tag="-1" Click="Step_Click" ToolTip="Bajar 1 punto" />
            <Button Grid.Column="1" Style="{StaticResource StepButton}" Content="−0,1" Tag="-0.1" Click="Step_Click" Margin="6,0,0,0" ToolTip="Bajar 0,1 puntos" />
            <Border Grid.Column="2" Margin="8,0" Height="30" CornerRadius="5" Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="%" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="ExactBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}" FontFamily="Consolas, Segoe UI" FontSize="14" VerticalAlignment="Center"
                             HorizontalContentAlignment="Right" Padding="4,0" KeyDown="ExactBox_KeyDown" LostKeyboardFocus="ExactBox_LostFocus"
                             ToolTip="Escribe el volumen exacto y pulsa Enter" />
                </DockPanel>
            </Border>
            <Button Grid.Column="3" Style="{StaticResource StepButton}" Content="+0,1" Tag="0.1" Click="Step_Click" ToolTip="Subir 0,1 puntos" />
            <Button Grid.Column="4" Style="{StaticResource StepButton}" Content="+1" Tag="1" Click="Step_Click" Margin="6,0,0,0" ToolTip="Subir 1 punto" />
        </Grid>

        <TextBlock x:Name="HintText" FontSize="11.5" Foreground="{DynamicResource Text3Brush}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
