<Window x:Class="Echoplex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Echoplex"
        xmlns:vm="clr-namespace:Echoplex.ViewModels"
        xmlns:m="clr-namespace:Echoplex.Models"
        Title="Echoplex" Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14" Icon="Assets/echoplex.ico"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown" Closing="Window_Closing" Loaded="Window_Loaded">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="ThumbPrev" Description="Anterior" Click="ThumbPrev_Click" />
                <ThumbButtonInfo x:Name="ThumbPlay" Description="Reproducir / Pausa" Click="ThumbPlay_Click" />
                <ThumbButtonInfo x:Name="ThumbNext" Description="Siguiente" Click="ThumbNext_Click" />
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Window.Resources>

        <!-- ================= Contenedores de lista ================= -->
        <Style x:Key="HeaderItemStyle" TargetType="ListViewItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="RowMenu" x:Shared="False" Tag="row" />

        <Style x:Key="SongRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="56,0" />
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
            <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
            <EventSetter Event="KeyDown" Handler="Row_KeyDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Border x:Name="HoverLayer" Background="{DynamicResource HoverBrush}" Opacity="0" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- resaltado con fundido al pasar el ratón -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:RowStyleSelector x:Key="RowSelector" HeaderStyle="{StaticResource HeaderItemStyle}" RowStyle="{StaticResource SongRowStyle}" />

        <Style x:Key="CellBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- borde arrastrable entre columnas de la tabla -->
        <Style x:Key="ColumnGrip" TargetType="Thumb">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Width" Value="9" />
            <Setter Property="Margin" Value="0,4,-5,4" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Panel.ZIndex" Value="2" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="Arrastra para cambiar el ancho" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border x:Name="Bar" Width="2" HorizontalAlignment="Center" Background="Transparent" CornerRadius="1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Text3Brush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ================= Fila de canción (tabla estilo Notion) ================= -->
        <DataTemplate DataType="{x:Type vm:SongRow}">
            <Grid Height="36" local:SongColumns.Host="True">

                <Border local:SongColumns.Key="number" Style="{StaticResource CellBorder}" Padding="0">
                    <Grid>
                        <TextBlock x:Name="Num" Text="{Binding Number}" Foreground="{DynamicResource Text3Brush}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- ecualizador animado de la canción que suena -->
                        <StackPanel x:Name="Eq" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="12"
                                    Visibility="Collapsed">
                            <Rectangle x:Name="EqBar1" Width="3" Height="12" Margin="0,0,2,0" Fill="{DynamicResource AccentBrush}" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="0.4" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="EqBar2" Width="3" Height="12" Margin="0,0,2,0" Fill="{DynamicResource AccentBrush}" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="0.8" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="EqBar3" Width="3" Height="12" Fill="{DynamicResource AccentBrush}" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="0.55" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                        <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xF5B0;" FontSize="12" Width="24" Height="24"
                                Foreground="{DynamicResource TextBrush}" Click="RowPlay_Click" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Border local:SongColumns.Key="title" Style="{StaticResource CellBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                   ToolTip="Solo en OneDrive: se descargará al reproducirla"
                                   Visibility="{Binding Song.IsCloud, Converter={StaticResource BoolVis}}" />
                        <TextBlock x:Name="TitleText" Style="{StaticResource CellText}" Text="{Binding Song.Title}" />
                    </DockPanel>
                </Border>

                <Border local:SongColumns.Key="artist" Style="{StaticResource CellBorder}">
                    <TextBlock Text="{Binding Song.Artist}" FontSize="14" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource LinkText}" />
                        </TextBlock.Style>
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{x:Static local:MainWindow.OpenArtistCommand}" CommandParameter="{Binding Song}" />
                        </TextBlock.InputBindings>
                    </TextBlock>
                </Border>

                <Border local:SongColumns.Key="album" Style="{StaticResource CellBorder}">
                    <TextBlock Text="{Binding Song.Album}" FontSize="14" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource LinkText}" />
                        </TextBlock.Style>
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{x:Static local:MainWindow.OpenAlbumCommand}" CommandParameter="{Binding Song}" />
                        </TextBlock.InputBindings>
                    </TextBlock>
                </Border>

                <Border local:SongColumns.Key="extra" Style="{StaticResource CellBorder}"
                        Visibility="{Binding DataContext.ShowExtra, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolVis}}">
                    <TextBlock Style="{StaticResource CellText}" Text="{Binding Extra}" Foreground="{DynamicResource Text2Brush}" FontSize="13" />
                </Border>

                <Border local:SongColumns.Key="format" Style="{StaticResource CellBorder}">
                    <Border DataContext="{Binding Song}" Style="{StaticResource FormatTag}">
                        <TextBlock Text="{Binding Format}" FontSize="12" />
                    </Border>
                </Border>

                <Border local:SongColumns.Key="fav" Style="{StaticResource CellBorder}" Padding="0">
                    <Button x:Name="Heart" Style="{StaticResource HeartButton}" FontSize="13" Width="26" Height="26"
                            Content="{Binding Song.IsFavorite, Converter={StaticResource HeartGlyph}}" Tag="{Binding Song.IsFavorite}"
                            Click="RowHeart_Click" Visibility="Hidden" ToolTip="Favorita" />
                </Border>

                <TextBlock local:SongColumns.Key="duration" Text="{Binding Song.DurationText}" FontSize="13" Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Song.IsFavorite}" Value="True">
                    <Setter TargetName="Heart" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Song.IsCurrent}" Value="True">
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Song.IsCurrent}" Value="True" />
                        <Condition Binding="{Binding DataContext.Player.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Num" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="Eq" Property="Visibility" Value="Visible" />
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="EqDance">
                            <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                <DoubleAnimation Storyboard.TargetName="EqBar1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.25" To="1" Duration="0:0:0.42" AutoReverse="True" RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetName="EqBar2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1" To="0.3" Duration="0:0:0.57" AutoReverse="True" RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetName="EqBar3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.45" To="0.95" Duration="0:0:0.36" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="EqDance" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                    <Setter TargetName="Num" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="Eq" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PlayBtn" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Heart" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True" />
                        <Condition Binding="{Binding Song.IsCurrent}" Value="True" />
                        <Condition Binding="{Binding DataContext.Player.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="PlayBtn" Property="Content" Value="&#xF8AE;" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= Tarjeta (galerías, inicio, búsqueda) ================= -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:CardVm}">
            <Button x:Name="Card" Style="{StaticResource CardButton}" Width="176" Margin="0,0,16,16" Click="Card_Click" Loaded="Card_Loaded"
                    MouseRightButtonUp="Card_RightClick" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave" RenderTransformOrigin="0.5,0.5">
                <StackPanel>
                    <Grid Height="156">
                        <Border CornerRadius="6,6,0,0" Background="{DynamicResource PlaceholderBrush}">
                            <ContentControl Style="{StaticResource GlyphIcon}" Content="{Binding Glyph}" FontSize="40" />
                        </Border>
                        <Border x:Name="CoverArt" CornerRadius="6,6,0,0" Visibility="{Binding Cover, Converter={StaticResource NullVis}}"
                                Style="{StaticResource FadeInOnShow}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                    <ImageBrush.RelativeTransform>
                                        <ScaleTransform CenterX="0.5" CenterY="0.5" />
                                    </ImageBrush.RelativeTransform>
                                </ImageBrush>
                            </Border.Background>
                        </Border>
                        <Button x:Name="CardPlay" Style="{StaticResource PlayCircleButton}" Width="38" Height="38" FontSize="14" Content="&#xF5B0;"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Opacity="0" Click="CardPlay_Click"
                                Effect="{StaticResource SoftShadow}" ToolTip="Reproducir">
                            <Button.RenderTransform>
                                <TranslateTransform Y="6" />
                            </Button.RenderTransform>
                        </Button>
                    </Grid>
                    <StackPanel Margin="12,10,12,12">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <!-- el botón de reproducir sube y aparece con un fundido -->
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardPlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetName="CardPlay" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                                <!-- zoom lento de la portada dentro de su marco -->
                                <DoubleAnimation Storyboard.TargetName="CoverArt" Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleX)"
                                                 To="1.12" Duration="0:0:0.9" EasingFunction="{StaticResource EaseOut}" />
                                <DoubleAnimation Storyboard.TargetName="CoverArt" Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleY)"
                                                 To="1.12" Duration="0:0:0.9" EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardPlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetName="CardPlay" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="6" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                                <DoubleAnimation Storyboard.TargetName="CoverArt" Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.5" EasingFunction="{StaticResource EaseOut}" />
                                <DoubleAnimation Storyboard.TargetName="CoverArt" Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.5" EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- ================= Cabecera de página de canciones ================= -->
        <DataTemplate DataType="{x:Type vm:ListHeader}">
            <StackPanel>
                <Grid Height="190" ClipToBounds="True" Visibility="{Binding Page.Cover, Converter={StaticResource NullVis}}" Style="{StaticResource FadeInOnShow}">
                    <Rectangle Margin="-60">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding Page.Cover}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <BlurEffect Radius="45" KernelType="Gaussian" />
                        </Rectangle.Effect>
                    </Rectangle>
                </Grid>
                <Border Height="48" Visibility="{Binding Page.Cover, Converter={StaticResource NullVis}, ConverterParameter=invert}" />

                <Grid Margin="56,0,56,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="380" />
                    <ColumnDefinition Width="2*" MaxWidth="500" />
                </Grid.ColumnDefinitions>

                <!-- al pasar el ratón por la portada pequeña: la portada en grande, a color, en el hueco de la derecha -->
                <Viewbox x:Name="BigCover" Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right"
                         VerticalAlignment="Top" Margin="32,18,0,20" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.9,0.1">
                    <Viewbox.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Viewbox.RenderTransform>
                    <Border Width="440" Height="440" CornerRadius="10" Effect="{StaticResource SoftShadow}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Page.Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                </Viewbox>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,-72,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding Page.Cover, Converter={StaticResource NullVis}}">
                        <!-- entra girando y rebotando (HeaderCover_VisibleChanged) y lanza un destello de la portada -->
                        <Border x:Name="HeaderCover" Width="124" Height="124" CornerRadius="6" BorderThickness="3" Cursor="Hand"
                                BorderBrush="{DynamicResource BgBrush}" Effect="{StaticResource SoftShadow}" RenderTransformOrigin="0.5,0.5"
                                IsVisibleChanged="HeaderCover_VisibleChanged" MouseLeftButtonUp="HeaderCover_Click" MouseRightButtonUp="HeaderCover_RightClick"
                                ToolTip="Ver la portada en grande">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Page.Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border.Background>
                            <!-- capa en blanco y negro que aparece al pasar el ratón -->
                            <Border x:Name="GrayLayer" CornerRadius="3" Opacity="0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Page.Cover, Converter={StaticResource Grayscale}}" Stretch="UniformToFill"
                                                RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border.Background>
                            </Border>
                        </Border>
                        <TextBlock x:Name="CoverArrow" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="22" Opacity="0"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="-10" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                    <!-- sin carátula: el icono de la página; en carpetas y álbumes, un recuadro con "+" para poner una a mano -->
                    <Grid HorizontalAlignment="Left" Visibility="{Binding Page.Cover, Converter={StaticResource NullVis}, ConverterParameter=invert}">
                        <ContentControl Style="{StaticResource GlyphIcon}" Content="{Binding Page.Glyph}" FontSize="60" HorizontalAlignment="Left"
                                        Visibility="{Binding Page.CanSetCover, Converter={StaticResource InvBoolVis}}" />
                        <Button Click="PageAddCover_Click" Cursor="Hand" ToolTip="Poner una carátula"
                                Visibility="{Binding Page.CanSetCover, Converter={StaticResource BoolVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Box" Width="124" Height="124" CornerRadius="8" BorderThickness="1.5"
                                            Background="{DynamicResource PlaceholderBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <Grid>
                                            <ContentControl Style="{StaticResource GlyphIcon}" Content="{Binding Page.Glyph}" FontSize="46" />
                                            <Border x:Name="Plus" Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,8,8" Background="{DynamicResource AccentBrush}">
                                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource OnAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Plus" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding Page.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Bold"
                               TextWrapping="Wrap" Margin="0,18,0,4" />
                    <TextBlock Text="{Binding Page.Description}" Foreground="{DynamicResource Text2Brush}" FontSize="14" TextWrapping="Wrap"
                               Visibility="{Binding Page.Description, Converter={StaticResource NullVis}}" />

                    <ItemsControl ItemsSource="{Binding Page.Properties}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PropertyItem}">
                                <Border x:Name="Bd" CornerRadius="4" Height="32" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Margin="0,18,0,20" Visibility="{Binding Page.IsEmpty, Converter={StaticResource InvBoolVis}}">
                        <Button Style="{StaticResource PrimaryButton}" Click="PagePlay_Click" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Page.PlayGlyph}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                           Margin="0,1,8,0" />
                                <TextBlock Text="{Binding Page.PlayText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Click="PageShuffle_Click" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                                <TextBlock Text="Aleatorio" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Click="PageRadio_Click" Margin="0,0,8,8"
                                ToolTip="Mezcla canciones parecidas a esta lista">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                                <TextBlock Text="Radio" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Click="PageDownload_Click" Margin="0,0,8,8"
                                Visibility="{Binding Page.CanDownload, Converter={StaticResource BoolVis}}"
                                ToolTip="Mantener en este dispositivo o liberar espacio (OneDrive)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                                <TextBlock Text="Descargar" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Click="PageMore_Click" Margin="0,0,8,8" Width="32" Padding="0" ToolTip="Más opciones">
                            <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        </Button>
                        <!-- títulos de esta carpeta (y sus subcarpetas): nombre del archivo o metadatos -->
                        <CheckBox Style="{StaticResource Switch}" Content="Nombres fichero" FontSize="14" Margin="10,0,0,8" VerticalAlignment="Center"
                                  IsChecked="{Binding Page.FileNamesOn, Mode=OneWay}" Click="PageFileNames_Click"
                                  Visibility="{Binding Page.IsRealFolder, Converter={StaticResource BoolVis}}"
                                  ToolTip="Títulos por nombre de archivo en esta carpeta y sus subcarpetas (en vez de los metadatos)" />
                    </WrapPanel>
                </StackPanel>
                </Grid>

                    <StackPanel Visibility="{Binding Page.HasAlbums, Converter={StaticResource BoolVis}}" Margin="56,0,56,12">
                        <TextBlock Text="{Binding Page.AlbumsHeader}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Page.Albums}" ItemTemplate="{StaticResource CardTemplate}"
                                      ItemsPanel="{StaticResource WrapPanelTemplate}" />
                        <TextBlock Text="Canciones" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8" Visibility="{Binding Page.HasRows, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                <Border Margin="56,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,1" Height="34"
                        Visibility="{Binding Page.HasRows, Converter={StaticResource BoolVis}}">
                    <Grid x:Name="ColumnHeaderGrid" local:SongColumns.Host="True" Background="Transparent" AllowDrop="True"
                          DragOver="ColumnHeader_DragOver" DragLeave="ColumnHeader_DragLeave" Drop="ColumnHeader_Drop" MouseRightButtonUp="ColumnHeader_RightClick">
                        <Border local:SongColumns.Key="number" Style="{StaticResource CellBorder}" Padding="0">
                            <Button Style="{StaticResource ColumnHeaderButton}" Tag="" Click="Sort_Click" HorizontalContentAlignment="Center"
                                    ToolTip="Orden original">
                                <TextBlock Text="#" />
                            </Button>
                        </Border>
                        <Border local:SongColumns.Key="title" PreviewMouseLeftButtonDown="ColumnHeader_MouseDown" PreviewMouseMove="ColumnHeader_MouseMove" Style="{StaticResource CellBorder}" Padding="0">
                            <Button Style="{StaticResource ColumnHeaderButton}" Tag="title" Click="Sort_Click">
                                <TextBlock><Run Text="Aa" FontWeight="SemiBold" Foreground="{DynamicResource Text3Brush}" /><Run Text="  Título" /><Run Text="{Binding Page.TitleSort, Mode=OneWay}" /></TextBlock>
                            </Button>
                        </Border>
                        <Border local:SongColumns.Key="artist" PreviewMouseLeftButtonDown="ColumnHeader_MouseDown" PreviewMouseMove="ColumnHeader_MouseMove" Style="{StaticResource CellBorder}" Padding="0">
                            <Button Style="{StaticResource ColumnHeaderButton}" Tag="artist" Click="Sort_Click">
                                <TextBlock><Run Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource Text3Brush}" /><Run Text="  Artista" /><Run Text="{Binding Page.ArtistSort, Mode=OneWay}" /></TextBlock>
                            </Button>
                        </Border>
                        <Border local:SongColumns.Key="album" PreviewMouseLeftButtonDown="ColumnHeader_MouseDown" PreviewMouseMove="ColumnHeader_MouseMove" Style="{StaticResource CellBorder}" Padding="0">
                            <Button Style="{StaticResource ColumnHeaderButton}" Tag="album" Click="Sort_Click">
                                <TextBlock><Run Text="&#xE93C;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource Text3Brush}" /><Run Text="  Álbum" /><Run Text="{Binding Page.AlbumSort, Mode=OneWay}" /></TextBlock>
                            </Button>
                        </Border>
                        <Border local:SongColumns.Key="extra" PreviewMouseLeftButtonDown="ColumnHeader_MouseDown" PreviewMouseMove="ColumnHeader_MouseMove" Style="{StaticResource CellBorder}" Padding="0"
                                Visibility="{Binding Page.ShowExtra, Converter={StaticResource BoolVis}}">
                            <Button Style="{StaticResource ColumnHeaderButton}" Tag="extra" Click="Sort_Click">
                                <TextBlock><Run Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource Text3Brush}" /><Run Text="  " /><Run Text="{Binding Page.ExtraHeader, Mode=OneWay}" /></TextBlock>
                            </Button>
                        </Border>
                        <Border local:SongColumns.Key="format" PreviewMouseLeftButtonDown="ColumnHeader_MouseDown" PreviewMouseMove="ColumnHeader_MouseMove" Style="{StaticResource CellBorder}" Padding="0">
                            <Button Style="{StaticResource ColumnHeaderButton}" Tag="format" Click="Sort_Click">
                                <TextBlock><Run Text="Tipo" /><Run Text="{Binding Page.FormatSort, Mode=OneWay}" /></TextBlock>
                            </Button>
                        </Border>
                        <Border local:SongColumns.Key="fav" PreviewMouseLeftButtonDown="ColumnHeader_MouseDown" PreviewMouseMove="ColumnHeader_MouseMove" Style="{StaticResource CellBorder}" Padding="0">
                            <TextBlock Text="&#xEB51;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Text3Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button local:SongColumns.Key="duration" PreviewMouseLeftButtonDown="ColumnHeader_MouseDown" PreviewMouseMove="ColumnHeader_MouseMove" Style="{StaticResource ColumnHeaderButton}" Tag="duration" Click="Sort_Click" HorizontalContentAlignment="Right">
                            <TextBlock><Run Text="{Binding Page.DurationSort, Mode=OneWay}" /><Run Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="12" /></TextBlock>
                        </Button>
                        <!-- bordes para cambiar el ancho; arrastrar una cabecera la cambia de sitio -->
                        <Thumb local:SongColumns.Key="title" Style="{StaticResource ColumnGrip}" DragDelta="ColumnGrip_DragDelta" DragCompleted="ColumnGrip_DragCompleted" />
                        <Thumb local:SongColumns.Key="artist" Style="{StaticResource ColumnGrip}" DragDelta="ColumnGrip_DragDelta" DragCompleted="ColumnGrip_DragCompleted" />
                        <Thumb local:SongColumns.Key="album" Style="{StaticResource ColumnGrip}" DragDelta="ColumnGrip_DragDelta" DragCompleted="ColumnGrip_DragCompleted" />
                        <Thumb local:SongColumns.Key="extra" Style="{StaticResource ColumnGrip}" DragDelta="ColumnGrip_DragDelta" DragCompleted="ColumnGrip_DragCompleted" Visibility="{Binding Page.ShowExtra, Converter={StaticResource BoolVis}}" />
                        <Thumb local:SongColumns.Key="format" Style="{StaticResource ColumnGrip}" DragDelta="ColumnGrip_DragDelta" DragCompleted="ColumnGrip_DragCompleted" />
                        <Thumb local:SongColumns.Key="fav" Style="{StaticResource ColumnGrip}" DragDelta="ColumnGrip_DragDelta" DragCompleted="ColumnGrip_DragCompleted" />
                        <Thumb local:SongColumns.Key="duration" Style="{StaticResource ColumnGrip}" DragDelta="ColumnGrip_DragDelta" DragCompleted="ColumnGrip_DragCompleted" />
                        <Rectangle x:Name="ColumnDropLine" Grid.ColumnSpan="99" Width="2" HorizontalAlignment="Left" Fill="{DynamicResource AccentBrush}"
                                   Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="3" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding Page.EmptyText}" Foreground="{DynamicResource Text2Brush}" Margin="56,8,56,24" TextWrapping="Wrap"
                           Visibility="{Binding Page.IsEmpty, Converter={StaticResource BoolVis}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- clic en la portada: pequeña en blanco y negro, flecha y la portada en grande a la derecha (se queda hasta otro clic) -->
                <DataTrigger Binding="{Binding DataContext.ShowBigCover, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="GrayLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"
                                                 EasingFunction="{StaticResource EaseOut}" />
                                <DoubleAnimation Storyboard.TargetName="CoverArrow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                <DoubleAnimation Storyboard.TargetName="CoverArrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="0" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOut}" />
                                <DoubleAnimation Storyboard.TargetName="BigCover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.32"
                                                 EasingFunction="{StaticResource EaseOut}" />
                                <DoubleAnimation Storyboard.TargetName="BigCover" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.4" EasingFunction="{StaticResource EaseOut}" />
                                <DoubleAnimation Storyboard.TargetName="BigCover" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.4" EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="GrayLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetName="CoverArrow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetName="CoverArrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="-10" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetName="BigCover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                <DoubleAnimation Storyboard.TargetName="BigCover" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="0.94" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetName="BigCover" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="0.94" Duration="0:0:0.25" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= Módulo (disco / subcarpeta) en mitad de la lista ================= -->
        <DataTemplate DataType="{x:Type vm:GroupHeader}">
            <Grid Margin="56,30,56,8" Loaded="Group_Loaded">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="76" Height="76">
                    <Border CornerRadius="5" Background="{DynamicResource PlaceholderBrush}">
                        <TextBlock Text="&#xE93C;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource Text3Brush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="5" Visibility="{Binding Cover, Converter={StaticResource NullVis}}" Effect="{StaticResource SoftShadow}"
                            Style="{StaticResource FadeInOnShow}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,12,0">
                    <TextBlock Text="{Binding Kicker}" FontSize="12" Foreground="{DynamicResource Text3Brush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" Margin="0,2,0,2"
                               TextTrimming="CharacterEllipsis" ToolTip="Abrir" HorizontalAlignment="Left"
                               Style="{StaticResource LinkText}" MouseLeftButtonUp="GroupTitle_Click" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{DynamicResource Text2Brush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" Click="GroupShuffle_Click" ToolTip="Aleatorio" Margin="0,0,6,0" />
                    <Button Style="{StaticResource PlayCircleButton}" Content="&#xF5B0;" Click="GroupPlay_Click" ToolTip="Reproducir este disco" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="PageList" TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListView">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Página: lista de canciones ================= -->
        <DataTemplate DataType="{x:Type vm:SongListPage}">
            <ListView ItemsSource="{Binding Items}" Style="{StaticResource PageList}" ItemContainerStyleSelector="{StaticResource RowSelector}"
                      SelectionMode="Extended" SelectionChanged="SongList_SelectionChanged" />
        </DataTemplate>

        <!-- ================= Página: galería ================= -->
        <DataTemplate x:Key="GalleryHeaderTemplate">
            <StackPanel Margin="56,48,56,24">
                <TextBlock Text="{Binding Page.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="52" Foreground="{DynamicResource Text3Brush}" />
                <TextBlock Text="{Binding Page.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Bold" Margin="0,16,0,4" />
                <TextBlock Text="{Binding Page.Summary}" Foreground="{DynamicResource Text2Brush}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="GalleryRowTemplate">
            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource CardTemplate}" Margin="56,0,40,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
        <local:GalleryTemplateSelector x:Key="GallerySelector" HeaderTemplate="{StaticResource GalleryHeaderTemplate}"
                                       RowTemplate="{StaticResource GalleryRowTemplate}" />

        <DataTemplate DataType="{x:Type vm:GalleryPage}">
            <ListView ItemsSource="{Binding Rows}" Style="{StaticResource PageList}" ItemContainerStyle="{StaticResource HeaderItemStyle}"
                      ItemTemplateSelector="{StaticResource GallerySelector}" />
        </DataTemplate>

        <!-- ================= Página: inicio ================= -->
        <DataTemplate x:Key="QuickTileTemplate" DataType="{x:Type vm:CardVm}">
            <Button x:Name="Tile" Style="{StaticResource TileButton}" Height="56" Margin="0,0,10,10" Click="Card_Click">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="5" Margin="6,0,0,0" Background="{DynamicResource PlaceholderBrush}">
                        <ContentControl Style="{StaticResource GlyphIcon}" Content="{Binding Glyph}" FontSize="18" Foreground="{DynamicResource Text2Brush}" />
                    </Border>
                    <Button x:Name="TilePlay" DockPanel.Dock="Right" Style="{StaticResource PlayCircleButton}" Width="30" Height="30" FontSize="11"
                            Content="&#xF5B0;" Margin="0,0,12,0" Opacity="0" Click="CardPlay_Click" />
                    <StackPanel VerticalAlignment="Center" Margin="12,0,8,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TilePlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TilePlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HomePage}">
            <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="56,48,40,48">
                    <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource Text2Brush}" FontSize="13" />
                    <!-- saludo letra a letra -->
                    <ItemsControl ItemsSource="{Binding GreetingChars}" Margin="0,2,0,24" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GreetChar}">
                                <TextBlock Text="{Binding Ch}" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Bold"
                                           RenderTransformOrigin="0.5,0.7" Loaded="GreetChar_Loaded" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding QuickLinks}" ItemTemplate="{StaticResource QuickTileTemplate}" Margin="0,0,6,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding DataContext.TileColumns, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HomeSection}">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}"
                                                  ItemsPanel="{StaticResource WrapPanelTemplate}" MaxHeight="230" ClipToBounds="True" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ================= Página: búsqueda ================= -->
        <DataTemplate x:Key="SearchSongTemplate" DataType="{x:Type vm:SongRow}">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Height="46" MouseLeftButtonDown="SearchRow_MouseDown"
                    ContextMenu="{StaticResource RowMenu}">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="T" Text="{Binding Song.Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Song.Artist}" FontSize="12" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Song.Album}" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Song.DurationText}" FontSize="13" Foreground="{DynamicResource Text2Brush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Song.IsCurrent}" Value="True">
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,24,0,12" />
        </Style>

        <DataTemplate DataType="{x:Type vm:SearchPage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="56,40,40,48">
                    <TextBox Style="{StaticResource BigSearchBox}" Tag="Busca canciones, artistas, álbumes, carpetas…" Margin="0,0,16,0"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Loaded="BigSearch_Loaded" />
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,16,0" />

                    <TextBlock Text="Escribe para buscar en toda tu biblioteca. Consejo: Ctrl+K abre la búsqueda desde cualquier sitio."
                               Foreground="{DynamicResource Text2Brush}" Margin="0,20,0,0"
                               Visibility="{Binding HasQuery, Converter={StaticResource InvBoolVis}}" />
                    <TextBlock Text="No hay resultados. Prueba con otras palabras." Foreground="{DynamicResource Text2Brush}" Margin="0,20,0,0"
                               Visibility="{Binding NoResults, Converter={StaticResource BoolVis}}" />

                    <StackPanel Visibility="{Binding Songs, Converter={StaticResource NullVis}}" Margin="0,0,16,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="SearchAll_Click" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                <TextBlock><Run Text="Ver las " /><Run Text="{Binding TotalSongs, Mode=OneWay}" /><Run Text=" canciones →" /></TextBlock>
                            </Button>
                            <TextBlock Text="Canciones" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Songs}" ItemTemplate="{StaticResource SearchSongTemplate}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Artists, Converter={StaticResource NullVis}}">
                        <TextBlock Text="Artistas" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Artists}" ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Albums, Converter={StaticResource NullVis}}">
                        <TextBlock Text="Álbumes" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Albums}" ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Playlists, Converter={StaticResource NullVis}}">
                        <TextBlock Text="Playlists" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Playlists}" ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Folders, Converter={StaticResource NullVis}}">
                        <TextBlock Text="Carpetas" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ================= Página: resumen ================= -->
        <DataTemplate x:Key="RankTemplate" DataType="{x:Type vm:RankItem}">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Height="44" Cursor="Hand" MouseLeftButtonUp="Rank_Click">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Rank}" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StatBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CalloutBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <DataTemplate DataType="{x:Type vm:StatsPage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="56,48,44,48">
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="52" Foreground="{DynamicResource Text3Brush}" />
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Bold" Margin="0,16,0,4" />
                    <TextBlock Text="Basado en lo que has escuchado en Echoplex." Foreground="{DynamicResource Text2Brush}" />

                    <UniformGrid Columns="4" Margin="0,24,0,0">
                        <Border Style="{StaticResource StatBox}">
                            <StackPanel>
                                <TextBlock Text="Tiempo escuchado" Foreground="{DynamicResource Text2Brush}" FontSize="13" />
                                <TextBlock Text="{Binding TotalTime}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatBox}">
                            <StackPanel>
                                <TextBlock Text="Últimos 30 días" Foreground="{DynamicResource Text2Brush}" FontSize="13" />
                                <TextBlock Text="{Binding MonthTime}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatBox}">
                            <StackPanel>
                                <TextBlock Text="Reproducciones" Foreground="{DynamicResource Text2Brush}" FontSize="13" />
                                <TextBlock Text="{Binding PlayCount}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatBox}">
                            <StackPanel>
                                <TextBlock Text="Canciones distintas" Foreground="{DynamicResource Text2Brush}" FontSize="13" />
                                <TextBlock Text="{Binding DistinctSongs}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="Últimos 14 días" Style="{StaticResource SectionTitle}" Margin="0,32,0,16" />
                    <ItemsControl ItemsSource="{Binding Days}" Height="150">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BarItem}">
                                <DockPanel Width="40" ToolTip="{Binding Tip}" Background="Transparent">
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource Text3Brush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <Border Width="22" Height="{Binding Height}" CornerRadius="3,3,0,0" Background="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Bottom" Opacity="0.85" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Aún no hay datos: escucha algo y vuelve por aquí." Foreground="{DynamicResource Text2Brush}" Margin="0,24,0,0"
                               Visibility="{Binding HasData, Converter={StaticResource InvBoolVis}}" />

                    <Grid Margin="0,8,0,0" Visibility="{Binding HasData, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tus canciones más escuchadas" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding TopSongs}" ItemTemplate="{StaticResource RankTemplate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Artistas" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding TopArtists}" ItemTemplate="{StaticResource RankTemplate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Carpetas" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding TopFolders}" ItemTemplate="{StaticResource RankTemplate}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ================= Panel lateral: elementos ================= -->

        <HierarchicalDataTemplate DataType="{x:Type m:FolderNode}" ItemsSource="{Binding Children}">
            <DockPanel Loaded="TreeNode_Loaded">
                <TextBlock x:Name="Speaker" DockPanel.Dock="Right" Text="&#xE995;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,10,0" Visibility="Collapsed" />
                <Grid DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,8,0">
                    <ContentControl x:Name="Ic" Style="{StaticResource GlyphIcon}" Content="&#xE8B7;" FontSize="14" Foreground="{DynamicResource Text2Brush}" />
                    <Border CornerRadius="3" Visibility="{Binding Cover, Converter={StaticResource NullVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                </Grid>
                <TextBlock x:Name="Nm" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
            </DockPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                    <Setter TargetName="Ic" Property="Content" Value="&#xE8D6;" />
                </DataTrigger>
                <!-- camino hasta la canción que suena: todas las carpetas padre iluminadas -->
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Nm" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <!-- y el altavoz en la carpeta donde está la canción -->
                <DataTrigger Binding="{Binding IsPlayingHere}" Value="True">
                    <Setter TargetName="Speaker" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Nm" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <Style x:Key="FolderItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource FolderTreeItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu Tag="folder" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- cada carpeta de música es un bloque propio, separado del anterior -->
                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                    <Setter Property="Margin" Value="0,10,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="Margin" Value="18,18,0,4" />
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>

        <!-- ================= Panel derecho: cola ================= -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type m:Song}">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="8,5" MouseLeftButtonUp="UpNext_Click" Cursor="Hand">
                <DockPanel>
                    <Button x:Name="Remove" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="22"
                            Height="22" Click="QueueRemove_Click" Visibility="Hidden" ToolTip="Quitar de la cola" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                    <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ContextItemTemplate" DataType="{x:Type m:Song}">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="8,5" MouseLeftButtonUp="UpNext_Click" Cursor="Hand">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- valor de una fila de Detalles: a la derecha de la etiqueta o, con el panel estrecho, debajo -->
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.DetailsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Margin" Value="0,1,0,8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="Margin" Value="8,16,8,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="260" MinWidth="210" MaxWidth="440" />
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ======================= PANEL LATERAL ======================= -->
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}" Height="50" Margin="6,8,6,4" Click="Workspace_Click"
                            ToolTip="Tema claro/oscuro, atajos y ajustes">
                        <DockPanel>
                            <!-- logo de Echoplex: invertido (claro) en los temas oscuros, el original en el claro -->
                            <Image DockPanel.Dock="Left" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="pack://application:,,,/Echoplex;component/Assets/echoplex-logo.png" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                <Setter Property="Source" Value="pack://application:,,,/Echoplex;component/Assets/echoplex-logo-light.png" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="Echoplex" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>

                    <!-- menú fijo: aparece arriba al bajar por el panel, cuando el menú de navegación queda fuera de la vista -->
                    <Border x:Name="StickyNav" DockPanel.Dock="Top" Visibility="Collapsed" Padding="6,2,6,8" ClipToBounds="True"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Style="{StaticResource FadeInOnShow}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource StickyNavButton}" Content="&#xE80F;" CommandParameter="Inicio" Click="Home_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=home}" />
                            <Button Style="{StaticResource StickyNavButton}" Content="&#xE721;" CommandParameter="Buscar" Click="Search_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=search}" />
                            <Button Style="{StaticResource StickyNavButton}" Content="&#xEB52;" CommandParameter="Favoritas" Click="Favorites_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=favorites}" />
                            <Button Style="{StaticResource StickyNavButton}" Content="&#xE81C;" CommandParameter="Historial" Click="History_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=history}" />
                            <Button Style="{StaticResource StickyNavButton}" Content="&#xE710;" CommandParameter="Recientes" Click="Recent_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=recent}" />
                            <Button Style="{StaticResource StickyNavButton}" Content="&#xE9D2;" CommandParameter="Resumen" Click="Stats_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=stats}" />
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                        <DockPanel>
                        <!-- el resto de opciones (temas, carpetas, animaciones…) vive en Ajustes -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="14" Margin="0,0,10,0"
                                Click="Settings_Click" ToolTip="Ajustes (Ctrl+,)" />
                        <Button Style="{StaticResource NavButton}" Click="NewPlaylist_Click">
                            <DockPanel>
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE710;" />
                                <TextBlock Text="Nueva playlist" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                        </DockPanel>
                    </Border>

                    <!-- actualización descargada e instalada: falta reiniciar -->
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Margin="10,0,10,8" Click="RestartUpdate_Click"
                            Visibility="{Binding UpdateReady, Converter={StaticResource NullVis}}"
                            ToolTip="La versión nueva ya está instalada; se abre al reiniciar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding UpdateReady, StringFormat=Reiniciar para usar la {0}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  ScrollChanged="SidebarScroll_ScrollChanged">
                        <StackPanel Margin="0,2,0,16">
                            <Button Style="{StaticResource NavButton}" Click="Home_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=home}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;" />
                                    <TextBlock Text="Inicio" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Click="Search_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=search}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE721;" />
                                    <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Buscar" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Click="Favorites_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=favorites}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xEB52;" />
                                    <TextBlock Text="Favoritas" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Click="History_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=history}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE81C;" />
                                    <TextBlock Text="Historial" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Click="Recent_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=recent}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE710;" />
                                    <TextBlock Text="Añadidas recientemente" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button x:Name="LastNavButton" Style="{StaticResource NavButton}" Click="Stats_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=stats}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE9D2;" />
                                    <TextBlock Text="Tu resumen" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>

                            <TextBlock Text="Explorar" Style="{StaticResource SidebarSection}" />
                            <Button Style="{StaticResource NavButton}" Click="Artists_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=artists}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE77B;" />
                                    <TextBlock Text="Artistas" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Click="Albums_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=albums}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE93C;" />
                                    <TextBlock Text="Álbumes" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Click="Folders_Click"
                                    Tag="{Binding ActiveNav, Converter={StaticResource Eq}, ConverterParameter=folders}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8B7;" />
                                    <TextBlock Text="Carpetas" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>

                            <DockPanel Margin="0,0,10,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="12" Width="22" Height="22"
                                        VerticalAlignment="Bottom" Margin="0,0,0,2" Click="NewPlaylist_Click" ToolTip="Nueva playlist" />
                                <TextBlock Text="Playlists" Style="{StaticResource SidebarSection}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Playlists}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:Playlist}">
                                        <Button Style="{StaticResource NavButton}" Tag="{Binding IsSelected}" Click="Playlist_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu Tag="playlist" />
                                            </Button.ContextMenu>
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE90B;" />
                                                <TextBlock x:Name="Speaker" DockPanel.Dock="Right" Text="&#xE995;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                                <TextBlock x:Name="Nm" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="Speaker" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Nm" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Aún no tienes playlists" FontSize="13" Foreground="{DynamicResource Text3Brush}" Margin="44,4,0,0"
                                       Visibility="{Binding Playlists.Count, Converter={StaticResource EqVis}, ConverterParameter=0}" />

                            <DockPanel Margin="0,0,10,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                    <TextBlock Text="Escaneando…" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"
                                               Margin="0,0,6,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="11" Width="22" Height="22"
                                            Click="Rescan_Click" ToolTip="Volver a escanear las carpetas de música" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8F4;" FontSize="12" Width="22" Height="22"
                                            Click="ChangeFolder_Click" ToolTip="Añadir carpeta de música" />
                                </StackPanel>
                                <TextBlock Text="Carpetas" Style="{StaticResource SidebarSection}" />
                            </DockPanel>
                            <TextBlock Text="Cargando…" FontSize="13" Foreground="{DynamicResource Text3Brush}" Margin="44,4,0,0"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}" />
                            <TreeView x:Name="FolderTree" ItemsSource="{Binding Folders}" Style="{StaticResource FolderTreeView}"
                                      ItemContainerStyle="{StaticResource FolderItemStyle}" SelectedItemChanged="FolderTree_SelectedItemChanged" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right" Background="Transparent" Focusable="False"
                          ResizeBehavior="CurrentAndNext" ResizeDirection="Columns" Cursor="SizeWE" />

            <!-- ======================= CONTENIDO ======================= -->
            <Grid x:Name="MainArea" Grid.Column="1" SizeChanged="MainArea_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="12,0,16,0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="13" Click="Back_Click" IsEnabled="{Binding CanGoBack}"
                                ToolTip="Atrás (Alt+← o botón lateral del ratón)" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE72A;" FontSize="13" Click="Forward_Click" IsEnabled="{Binding CanGoForward}"
                                ToolTip="Adelante (Alt+→ o botón lateral del ratón)" Margin="2,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="FilterBox" DockPanel.Dock="Right" Style="{StaticResource FilterBox}" Width="230" Tag="Filtrar…"
                             VerticalAlignment="Center" Text="{Binding CurrentPage.Filter, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding CurrentPage.HasFilter, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding CurrentPage.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="{Binding CurrentPage.Breadcrumb}" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <!-- recortado: durante la transición las páginas crecen y se desplazan sin invadir la barra superior -->
                <Grid x:Name="Stage" Grid.Row="1" ClipToBounds="True">
                    <!-- aurora: manchas de color de la portada que flotan detrás del contenido -->
                    <Grid x:Name="Aurora" IsHitTestVisible="False" />
                    <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Focusable="False" RenderTransformOrigin="0.5,0.4" />
                    <!-- destello de la portada al abrir una página -->
                    <Image x:Name="Bloom" IsHitTestVisible="False" Visibility="Collapsed" Stretch="UniformToFill" HorizontalAlignment="Left"
                           VerticalAlignment="Top" Width="320" Height="320" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="LowQuality" />
                    <!-- captura de la página que se va, para las transiciones -->
                    <Image x:Name="TransitionShot" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"
                           RenderTransformOrigin="0.5,0.4" RenderOptions.BitmapScalingMode="LowQuality" />
                    <!-- teselas del estallido -->
                    <Canvas x:Name="Shards" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                    <Rectangle Style="{StaticResource NoteLogo}" Width="64" Height="64" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Text2Brush}" Margin="0,14,0,0" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="460" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Añadir carpeta de música…" Click="ChangeFolder_Click"
                            HorizontalAlignment="Center" Margin="0,18,0,0"
                            Visibility="{Binding NeedsFolder, Converter={StaticResource BoolVis}}" />
                </StackPanel>

                <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" Background="{DynamicResource ToastBrush}"
                        CornerRadius="6" Padding="14,8" Effect="{StaticResource SoftShadow}" IsHitTestVisible="False"
                        Visibility="{Binding Toast, Converter={StaticResource NullVis}}" Style="{StaticResource SlideUpOnShow}">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource ToastTextBrush}" FontSize="13" />
                </Border>
                <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,62" Background="#E03E3E"
                        CornerRadius="6" Padding="14,8" IsHitTestVisible="False"
                        Visibility="{Binding Player.Error, Converter={StaticResource NullVis}}">
                    <TextBlock Text="{Binding Player.Error}" Foreground="White" FontSize="13" />
                </Border>
            </Grid>

            <!-- ======================= PANEL DERECHO ======================= -->
            <!-- tirador del panel derecho: arrastrar cambia el ancho, doble clic lo devuelve al de siempre -->
            <Thumb x:Name="RightResizer" Grid.Column="2" Panel.ZIndex="1" HorizontalAlignment="Left" Width="6" Margin="-3,0,0,0" Cursor="SizeWE"
                   Focusable="False" DragDelta="RightResizer_DragDelta" MouseDoubleClick="RightResizer_DoubleClick" ToolTip="Arrastra para cambiar el ancho"
                   Visibility="{Binding ShowRightPanel, Converter={StaticResource BoolVis}}">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Line" Background="Transparent" Width="6">
                            <Border x:Name="Bar" Width="2" Background="Transparent" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource DividerBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Border x:Name="RightPanel" Grid.Column="2" Width="330" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowRightPanel, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Height="46" Margin="10,0,8,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Click="CloseRight_Click"
                                VerticalAlignment="Center" ToolTip="Cerrar panel" />
                        <!-- con el panel estrecho, las pestañas se encogen en vez de cortarse -->
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="A continuación" CommandParameter="queue" Click="Tab_Click" FontSize="14"
                                    Tag="{Binding RightTab, Converter={StaticResource Eq}, ConverterParameter=queue}" />
                            <Button Style="{StaticResource GhostButton}" Content="Letra" CommandParameter="lyrics" Click="Tab_Click" FontSize="14"
                                    Tag="{Binding RightTab, Converter={StaticResource Eq}, ConverterParameter=lyrics}" Margin="2,0" />
                            <Button Style="{StaticResource GhostButton}" Content="Detalles" CommandParameter="info" Click="Tab_Click" FontSize="14"
                                    Tag="{Binding RightTab, Converter={StaticResource Eq}, ConverterParameter=info}" />
                        </StackPanel>
                        </Viewbox>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerBrush}" />

                    <Grid>
                        <!-- Cola -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                      Visibility="{Binding RightTab, Converter={StaticResource EqVis}, ConverterParameter=queue}">
                            <StackPanel Margin="8,0,8,16">
                                <TextBlock Text="Sonando" Style="{StaticResource PanelLabel}" />
                                <DockPanel Margin="8,0" Visibility="{Binding Player.Current, Converter={StaticResource NullVis}}">
                                    <Grid DockPanel.Dock="Left" Width="52" Height="52">
                                        <Border CornerRadius="5" Background="{DynamicResource PlaceholderBrush}">
                                            <Rectangle Style="{StaticResource NoteLogo}" Width="22" Height="22" />
                                        </Border>
                                        <Border CornerRadius="5" Visibility="{Binding NowPlayingCover, Converter={StaticResource NullVis}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding NowPlayingCover}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Player.Current.Title}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Player.Current.Artist}" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="Nada sonando todavía." Foreground="{DynamicResource Text2Brush}" Margin="8,0"
                                           Visibility="{Binding Player.Current, Converter={StaticResource NullVis}, ConverterParameter=invert}" />

                                <StackPanel Visibility="{Binding Player.HasQueue, Converter={StaticResource BoolVis}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Vaciar" Click="ClearQueue_Click"
                                                VerticalAlignment="Bottom" Margin="0,0,4,2" />
                                        <TextBlock Text="En cola" Style="{StaticResource PanelLabel}" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Player.QueueNext}" ItemTemplate="{StaticResource QueueItemTemplate}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource PanelLabel}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Player.ContextNext.Count, Converter={StaticResource EqVis}, ConverterParameter=0, FallbackValue=Collapsed}"
                                           Text="Fin de la lista" />
                                <TextBlock Style="{StaticResource PanelLabel}" TextTrimming="CharacterEllipsis"
                                           Text="{Binding Player.ContextName, StringFormat=Siguiente de {0}}" />
                                <ItemsControl ItemsSource="{Binding Player.ContextNext}" ItemTemplate="{StaticResource ContextItemTemplate}" />

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Player.AutoRadio}" Margin="8,16,8,0" Foreground="{DynamicResource Text2Brush}" FontSize="13"
                                          Focusable="False">
                                    <TextBlock Text="Radio automática al acabar la lista" TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Letra -->
                        <DockPanel Visibility="{Binding RightTab, Converter={StaticResource EqVis}, ConverterParameter=lyrics}">
                        <!-- letras de internet (LRCLIB): siempre a mano, desactivado de serie -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,10,12,10">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OnlineLyrics}" FontSize="13"
                                      ToolTip="Busca en lrclib.net las letras que no tengan tus archivos (solo envía artista, título, álbum y duración)">
                                <TextBlock Text="Buscar letras en internet (LRCLIB)" TextWrapping="Wrap" />
                            </CheckBox>
                        </Border>
                        <Grid>
                            <ScrollViewer x:Name="LyricsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                          Visibility="{Binding HasLyrics, Converter={StaticResource BoolVis}}">
                                <StackPanel Margin="0,0,0,160">
                                <ItemsControl x:Name="LyricsList" ItemsSource="{Binding Lyrics}" Margin="20,24,20,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LyricLine}">
                                            <TextBlock x:Name="L" Text="{Binding Text}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5"
                                                       Foreground="{DynamicResource Text3Brush}" Cursor="Hand" MouseLeftButtonUp="Lyric_Click" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                    <Setter TargetName="L" Property="Foreground" Value="{DynamicResource Text2Brush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="L" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.LyricsSynced, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                    <Setter TargetName="L" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    <Setter TargetName="L" Property="FontSize" Value="16" />
                                                    <Setter TargetName="L" Property="FontWeight" Value="Normal" />
                                                    <Setter TargetName="L" Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Letra de LRCLIB (lrclib.net)" FontSize="12" Foreground="{DynamicResource Text3Brush}" Margin="20,18,20,0"
                                           Visibility="{Binding LyricsFromOnline, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Margin="24,32" Visibility="{Binding HasLyrics, Converter={StaticResource InvBoolVis}}">
                                <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="32" Foreground="{DynamicResource Text3Brush}" />
                                <TextBlock Text="No hay letra para esta canción" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6" />
                                <TextBlock Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" LineHeight="20"
                                           Text="Echoplex muestra letras sincronizadas si hay un archivo .lrc con el mismo nombre junto a la canción, o la letra guardada en sus etiquetas. Con la opción de abajo, también las busca en LRCLIB." />
                                <TextBlock Text="{Binding LyricsStatus}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,14,0,0"
                                           Visibility="{Binding LyricsStatus, Converter={StaticResource NullVis}}" />
                            </StackPanel>
                        </Grid>
                        </DockPanel>

                        <!-- Detalles -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                      Visibility="{Binding RightTab, Converter={StaticResource EqVis}, ConverterParameter=info}">
                            <StackPanel Margin="16,16,16,16">
                                <Grid Visibility="{Binding Player.Current, Converter={StaticResource NullVis}}">
                                    <Border x:Name="InfoCover" CornerRadius="6" Background="{DynamicResource PlaceholderBrush}"
                                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                                        <Rectangle Style="{StaticResource NoteLogo}" Width="64" Height="64" />
                                    </Border>
                                    <Border CornerRadius="6" Height="{Binding ActualWidth, ElementName=InfoCover}"
                                            Visibility="{Binding NowPlayingCover, Converter={StaticResource NullVis}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding NowPlayingCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Player.Current.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                                           TextWrapping="Wrap" Margin="0,16,0,12" />
                                <ItemsControl ItemsSource="{Binding InfoItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PropertyItem}">
                                            <Grid MinHeight="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="108" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                           Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource Text2Brush}" FontSize="13"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource DetailValue}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid MinHeight="30" Margin="0,4,0,0" Visibility="{Binding Player.Current, Converter={StaticResource NullVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Text3Brush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Salida" Foreground="{DynamicResource Text2Brush}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Player.OutputInfo}" Style="{StaticResource DetailValue}" />
                                </Grid>
                                <TextBlock Text="Reproduce algo para ver sus detalles." Foreground="{DynamicResource Text2Brush}"
                                           Visibility="{Binding Player.Current, Converter={StaticResource NullVis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================= BARRA DE REPRODUCCIÓN ======================= -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource BgBrush}">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="220" />
                    <ColumnDefinition Width="4*" MaxWidth="720" />
                    <ColumnDefinition x:Name="PlayerRightCol" Width="3*" MinWidth="220" />
                </Grid.ColumnDefinitions>

                <DockPanel VerticalAlignment="Center" Visibility="{Binding Player.Current, Converter={StaticResource NullVis}}">
                    <Grid x:Name="PlayerCover" DockPanel.Dock="Left" Width="48" Height="48" Cursor="Hand" MouseLeftButtonUp="NowPlayingCover_Click"
                          ToolTip="Ver detalles" RenderTransformOrigin="0.5,0.5">
                        <!-- anillo de luz al cambiar de canción -->
                        <Border x:Name="CoverGlow" CornerRadius="8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Opacity="0"
                                Margin="-2" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" />
                        <Border CornerRadius="5" Background="{DynamicResource PlaceholderBrush}">
                            <Rectangle Style="{StaticResource NoteLogo}" Width="22" Height="22" />
                        </Border>
                        <Border CornerRadius="5" Visibility="{Binding NowPlayingCover, Converter={StaticResource NullVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding NowPlayingCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <Button DockPanel.Dock="Right" Style="{StaticResource HeartButton}" VerticalAlignment="Center" Margin="4,0,8,0"
                            Content="{Binding Player.Current.IsFavorite, Converter={StaticResource HeartGlyph}}" Tag="{Binding Player.Current.IsFavorite}"
                            Click="CurrentHeart_Click" ToolTip="Favorita (Ctrl+L)" />
                    <StackPanel Margin="12,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Player.Current.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Player.Current.Title}" Style="{StaticResource LinkText}" HorizontalAlignment="Left"
                                   MouseLeftButtonUp="CurrentTitle_Click" />
                        <TextBlock Text="{Binding Player.Current.Artist}" FontSize="12" Foreground="{DynamicResource Text2Brush}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" Style="{StaticResource LinkText}" HorizontalAlignment="Left"
                                   MouseLeftButtonUp="CurrentArtist_Click"
                                   Visibility="{Binding Player.IsBuffering, Converter={StaticResource InvBoolVis}}" />
                        <TextBlock Text="{Binding Player.LoadingText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"
                                   Visibility="{Binding Player.IsBuffering, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ToggleButton Style="{StaticResource StateButton}" Content="&#xE8B1;" IsChecked="{Binding Player.Shuffle}"
                                      ToolTip="Aleatorio (Ctrl+S)" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Previous_Click" Margin="10,0,0,0" ToolTip="Anterior (Ctrl+←)" />
                        <Button Style="{StaticResource PlayCircleButton}" Content="{Binding Player.PlayGlyph}" Click="PlayPause_Click" Margin="12,0"
                                ToolTip="Reproducir / Pausa (Espacio)" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" Margin="0,0,10,0" ToolTip="Siguiente (Ctrl+→)" />
                        <Button Style="{StaticResource StateButton}" Content="{Binding Player.RepeatGlyph}" Tag="{Binding Player.IsRepeatOn}"
                                Click="Repeat_Click" ToolTip="{Binding Player.RepeatTip}" />
                    </StackPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PosText" Text="0:00" FontSize="11" Foreground="{DynamicResource Text2Brush}" TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" Margin="8,0" />
                        <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" FontSize="11" Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- Bit a bit, mini reproductor y volumen siempre a la vista; temporizador, letra, cola y detalles (PlayerExtras) pasan a un menú con flecha si no caben -->
                <StackPanel x:Name="PlayerRight" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PillButton}" Tag="{Binding Player.ExclusiveMode}" Click="BitPerfect_Click" Margin="0,0,10,0"
                            ToolTip="{Binding Player.OutputInfo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,1,5,0" />
                            <TextBlock Text="Bit a bit" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="ExtrasInline">
                        <StackPanel x:Name="PlayerExtras" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SleepText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,2,0"
                                       Visibility="{Binding SleepText, Converter={StaticResource NullVis}}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE708;" Tag="{Binding SleepActive}" Click="Sleep_Click"
                                    ToolTip="Temporizador de apagado" Margin="2,0,0,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BD;" Tag="{Binding LyricsTabActive}" Click="LyricsToggle_Click"
                                    ToolTip="Letra" Margin="2,0,0,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8FD;" Tag="{Binding QueueTabActive}" Click="QueueToggle_Click"
                                    ToolTip="Cola (Ctrl+Q)" Margin="2,0,0,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE946;" Tag="{Binding InfoTabActive}" Click="InfoToggle_Click"
                                    ToolTip="Detalles" Margin="2,0,0,0" />
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="ExtrasToggle" Style="{StaticResource IconButton}" Content="&#xE70E;" Margin="2,0,0,0" Visibility="Collapsed"
                                  ToolTip="Temporizador, letra, cola y detalles" Checked="ExtrasToggle_Checked" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Click="Mini_Click" ToolTip="Mini reproductor (Ctrl+M)" Margin="2,0,0,0" />
                    <!-- el volumen siempre en la barra -->
                    <Button Style="{StaticResource IconButton}" Content="{Binding Player.VolumeGlyph}" Click="Mute_Click" ToolTip="Silenciar"
                            Margin="8,0,0,0" />
                    <Slider x:Name="VolumeSlider" Style="{StaticResource ThinSlider}" Width="96" Minimum="0" Maximum="1" Margin="4,0,0,0"
                            Value="{Binding Player.Volume, Mode=TwoWay}" />
                </StackPanel>
                <Popup x:Name="ExtrasPopup" PlacementTarget="{Binding ElementName=ExtrasToggle}" Placement="Top" VerticalOffset="-6"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="ExtrasPopup_Closed">
                    <Border x:Name="ExtrasPopupHost" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="10" Effect="{StaticResource PopupShadow}" />
                </Popup>
            </Grid>
        </Border>
    </Grid>
</Window>
