<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta clara inspirada en Notion -->
    <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F7F7F5" />
    <SolidColorBrush x:Key="TextBrush" Color="#37352F" />
    <SolidColorBrush x:Key="Text2Brush" Color="#787774" />
    <SolidColorBrush x:Key="Text3Brush" Color="#A5A4A0" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#5F5E5B" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EDEDEB" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F1EF" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#EBEBE9" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#E7E7E4" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2383E2" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0B6BCB" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E9F2FB" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E9E9E7" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#E3E2DF" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#F1F1EF" />
    <SolidColorBrush x:Key="InputBrush" Color="#F4F4F2" />
    <SolidColorBrush x:Key="CalloutBrush" Color="#F7F7F5" />
    <SolidColorBrush x:Key="FavBrush" Color="#E03E3E" />
    <SolidColorBrush x:Key="ToastBrush" Color="#2F2E2B" />
    <SolidColorBrush x:Key="ToastTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#D9D8D4" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#BDBCB7" />
    <SolidColorBrush x:Key="TrackBrush" Color="#E3E2DF" />
    <SolidColorBrush x:Key="PlayCircleBrush" Color="#37352F" />
    <SolidColorBrush x:Key="OnPlayCircleBrush" Color="#FFFFFF" />
    <Color x:Key="ShadowColor">#1A0F0F0F</Color>

    <!-- Etiquetas de colores (formato de archivo) -->
    <SolidColorBrush x:Key="TagGrayBg" Color="#E3E2E0" />
    <SolidColorBrush x:Key="TagGrayFg" Color="#32302C" />
    <SolidColorBrush x:Key="TagBlueBg" Color="#D3E5EF" />
    <SolidColorBrush x:Key="TagBlueFg" Color="#183347" />
    <SolidColorBrush x:Key="TagGreenBg" Color="#DBEDDB" />
    <SolidColorBrush x:Key="TagGreenFg" Color="#1C3829" />
    <SolidColorBrush x:Key="TagOrangeBg" Color="#FADEC9" />
    <SolidColorBrush x:Key="TagOrangeFg" Color="#49290E" />
    <SolidColorBrush x:Key="TagPurpleBg" Color="#E8DEEE" />
    <SolidColorBrush x:Key="TagPurpleFg" Color="#412454" />
    <SolidColorBrush x:Key="TagYellowBg" Color="#FDECC8" />
    <SolidColorBrush x:Key="TagYellowFg" Color="#402C1B" />
    <SolidColorBrush x:Key="TagPinkBg" Color="#F5E0E9" />
    <SolidColorBrush x:Key="TagPinkFg" Color="#4C2337" />
</ResourceDictionary>
