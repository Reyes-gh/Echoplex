<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Echoplex"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- ===== Tipografía ===== -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <sys:Boolean x:Key="True">True</sys:Boolean>

    <BooleanToVisibilityConverter x:Key="BoolVis" />
    <local:InverseBoolToVisibilityConverter x:Key="InvBoolVis" />
    <local:NullToVisibilityConverter x:Key="NullVis" />
    <local:GrayscaleConverter x:Key="Grayscale" />
    <local:TreeIndentConverter x:Key="TreeIndent" />
    <local:EqualsConverter x:Key="Eq" />
    <local:EqualsToVisibilityConverter x:Key="EqVis" />
    <local:HeartGlyphConverter x:Key="HeartGlyph" />

    <!-- ===== Nota de Echoplex ===== -->
    <!-- La imagen es blanca sobre transparente: se usa de máscara y se pinta con el color del tema (claro, oscuro, neón…) -->
    <ImageBrush po:Freeze="True" x:Key="NoteMask" ImageSource="pack://application:,,,/Echoplex;component/Assets/note.png" Stretch="Uniform" />

    <Style x:Key="NoteLogo" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource Text3Brush}" />
        <Setter Property="OpacityMask" Value="{StaticResource NoteMask}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <!-- Icono de la fuente de iconos; si es la nota musical genérica (U+E8D6) se dibuja la nota de Echoplex -->
    <Style x:Key="GlyphIcon" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <TextBlock x:Name="Glyph" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontFamily="{StaticResource IconFont}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Rectangle x:Name="Note" Style="{StaticResource NoteLogo}" Fill="{TemplateBinding Foreground}" Visibility="Collapsed"
                                   Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="&#xE8D6;">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Note" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Animaciones ===== -->
    <CubicEase po:Freeze="True" x:Key="EaseOut" EasingMode="EaseOut" />

    <!-- Aparece con un fundido suave cuando se hace visible (portadas que llegan después de la página) -->
    <!-- (solo con las animaciones activadas: local:Anim.Enabled se hereda de la ventana) -->
    <Style x:Key="FadeInOnShow" TargetType="FrameworkElement">
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsVisible" Value="True" />
                    <Condition Property="local:Anim.Enabled" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.38"
                                             EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Aviso emergente: entra con fundido y deslizamiento (el elemento debe tener un TranslateTransform propio) -->
    <Style x:Key="SlideUpOnShow" TargetType="FrameworkElement">
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsVisible" Value="True" />
                    <Condition Property="local:Anim.Enabled" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"
                                             EasingFunction="{StaticResource EaseOut}" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0"
                                             Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Interruptor (CheckBox con aspecto de switch): pista redondeada, bolita que se desliza, color de acento al activarse -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" VerticalAlignment="Center"
                                Background="{DynamicResource TrackBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0,0,0"
                                     Fill="{DynamicResource Text2Brush}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobMove" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"
                                                         EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón del menú fijo del panel lateral: solo icono; al pasar el ratón se alarga y aparece el nombre (CommandParameter).
         Tag = sección activa. -->
    <Style x:Key="StickyNavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Padding="7,6" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock x:Name="Label" Text="{Binding CommandParameter, RelativeSource={RelativeSource TemplatedParent}}" FontSize="13"
                                       VerticalAlignment="Center" Margin="6,0,0,0" MaxWidth="0" Opacity="0" TextTrimming="None" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="MaxWidth" To="120" Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="MaxWidth" To="0" Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DropShadowEffect po:Freeze="True" x:Key="SoftShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.14" Color="#000000" />
    <DropShadowEffect po:Freeze="True" x:Key="PopupShadow" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#000000" />

    <!-- ===== Botones ===== -->

    <Style x:Key="IconButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Micrófono de mano (de cantar) para la letra: la fuente de iconos solo trae el de grabación -->
    <StreamGeometry po:Freeze="True" x:Key="SingMicGeometry">M 14.3,4.7 A 3,3 0 1 1 8.3,4.7 A 3,3 0 1 1 14.3,4.7 Z M 11.56,7.69 L 6.28,11.84 A 1.5,1.5 0 0 1 4.16,9.72 L 8.31,4.44</StreamGeometry>
    <Style x:Key="SingMicIcon" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource SingMicGeometry}" />
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.25" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

