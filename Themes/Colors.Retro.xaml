    <SolidColorBrush x:Key="TagOrangeFg" Color="#FFD2A8" />
    <SolidColorBrush x:Key="TagPurpleBg" Color="#3E1C6B" />
    <SolidColorBrush x:Key="TagPurpleFg" Color="#E8CCFF" />
    <SolidColorBrush x:Key="TagYellowBg" Color="#4A3A10" />
    <SolidColorBrush x:Key="TagYellowFg" Color="#FFEBA8" />
