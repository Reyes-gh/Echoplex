<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 80's retro: atardecer synthwave, morado profundo, rosa chicle y naranja, texto crema -->
    <SolidColorBrush x:Key="BgBrush" Color="#1A0D2B" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#1F1030" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE4C9" />
    <SolidColorBrush x:Key="Text2Brush" Color="#C79BB5" />
    <SolidColorBrush x:Key="Text3Brush" Color="#8C6488" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#DDB4C8" />
    <SolidColorBrush x:Key="DividerBrush" Color="#33194A" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2A1440" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#2E1746" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#3A1C55" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3C9E" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6DB6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3D1438" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A0D2B" />
