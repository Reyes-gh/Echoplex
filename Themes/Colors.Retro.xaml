    <SolidColorBrush x:Key="InputBrush" Color="#24133B" />
    <SolidColorBrush x:Key="CalloutBrush" Color="#22123A" />
    <SolidColorBrush x:Key="FavBrush" Color="#FF8A3D" />
    <SolidColorBrush x:Key="ToastBrush" Color="#FF8A3D" />
    <SolidColorBrush x:Key="ToastTextBrush" Color="#1A0D2B" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A2872" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#63359A" />
    <SolidColorBrush x:Key="TrackBrush" Color="#4A2872" />
    <SolidColorBrush x:Key="PlayCircleBrush" Color="#FF8A3D" />
    <SolidColorBrush x:Key="OnPlayCircleBrush" Color="#1A0D2B" />
    <Color x:Key="ShadowColor">#88FF3C9E</Color>

    <SolidColorBrush x:Key="TagGrayBg" Color="#33204A" />
    <SolidColorBrush x:Key="TagGrayFg" Color="#F2D8E6" />
